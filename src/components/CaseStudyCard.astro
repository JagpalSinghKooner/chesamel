---
// Case Study card, as on the live site (#42): horizontal from 768px, with the
// image on the left third and the text on a white panel, at least 304px
// tall, stacked with the image on top on phones. The main label is a tag outlined in its Pillar
// accent (the live site fills it, which fails WCAG AA under white text:
// ADR-0002), then the client when known, the title and an arrow box.
// Built on Fulldev's Card (ADR-0005).
//
// `isNew` adds the Indigo "New" badge the Our Work "Latest Work" slider shows
// on every card. Every Case Study has an image (the schema requires one; the
// live site's "Financial Services Community Inaugural Event" only looks bare
// until its lazy image loads). Hover and keyboard focus follow the Blog Post
// card: the arrow box takes the accent and the image grows (not under
// reduced motion).
import { Card } from '@/components/ui/card';
import Icon from './Icon.astro';
import { focusOutline } from './button';
import { brandCard } from './card';
import { accentBorder, accentFillOnHover } from './accent';
import { pillarLabels } from '../data/taxonomy';
import { labelAccents } from '../data/pillars';
import type { CaseStudySummary } from '../content/case-studies';
import { primaryPillar } from '../content/shared';

interface Props {
  caseStudy: CaseStudySummary;
  headingLevel?: 'h2' | 'h3' | 'h4';
  // The background the card sits on, for its outline.
  tone?: 'light' | 'dark';
  isNew?: boolean;
}

const { caseStudy, headingLevel: Heading = 'h3', tone = 'light', isNew = false } = Astro.props;
const label = primaryPillar(caseStudy);
const accent = labelAccents[label];
const dark = tone === 'dark';
---

<Card
  as="a"
  href={caseStudy.address}
  class:list={[
    brandCard,
    focusOutline,
    'group h-full overflow-hidden border text-dark-grey md:min-h-76 md:flex-row',
    dark ? 'border-dark-grey focus-visible:outline-white' : 'border-light-grey focus-visible:outline-indigo',
  ]}
  data-component="case-study-card"
>
  <div class="aspect-2/1 shrink-0 overflow-hidden md:aspect-auto md:w-1/3">
    <img
      src={caseStudy.image.src}
      alt=""
      loading="lazy"
      class="size-full object-cover transition-transform duration-300 group-hover:scale-110 group-focus-visible:scale-110 motion-reduce:transition-none motion-reduce:group-hover:scale-100 motion-reduce:group-focus-visible:scale-100"
    />
  </div>
  <div class="flex grow flex-col justify-between gap-20 bg-white p-7.5">
    <div class="flex flex-wrap items-start gap-3">
      {isNew && <span class="bg-indigo px-5 py-3 text-base leading-none font-medium text-white" data-new>New</span>}
      <span class:list={['border px-5 py-3 text-base leading-none font-medium', accentBorder[accent]]} data-tag>{pillarLabels[label]}</span>
    </div>
    <div class="flex items-end justify-between gap-5">
      <div>
        {caseStudy.client && <p class="text-xl font-medium">/ {caseStudy.client}</p>}
        <Heading class="mt-1 text-xl leading-tight font-semibold text-dark-grey">{caseStudy.title}</Heading>
      </div>
      <span aria-hidden="true" class:list={['hidden size-11 shrink-0 place-items-center bg-medium-grey/20 transition-colors duration-300 md:grid', accentFillOnHover[accent]]} data-arrow-box>
        <Icon name="arrow-up-right" class="size-4 rtl:-scale-x-100" />
      </span>
    </div>
  </div>
</Card>
