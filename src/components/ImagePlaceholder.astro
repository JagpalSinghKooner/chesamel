---
// Stands in for a card image that is missing: a Black panel with the white
// brandmark, filling the space the image would (#42). Decorative.
import Logo from '../design-system/Logo.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div aria-hidden="true" class:list={['grid size-full place-items-center bg-band-dark', className]} data-image-placeholder>
  <Logo variant="brandmark" colour="white" height={48} />
</div>
