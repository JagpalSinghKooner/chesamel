---
// Link styled as the live site's square button with a ↗ arrow, built on
// Fulldev's Button (ADR-0005).
// `tone` picks a pairing that passes WCAG AA contrast (button.ts):
//   cta: live's Lime call to action      primary: Indigo with white text
//   dark: on light backgrounds           light: bordered, on light backgrounds
//   outline: bordered, on dark backgrounds
// Colours are theme roles (ADR-0006), so the brand palette turns the call to
// action Indigo.
//
// Sizes follow the live site: 16px semibold text and 16px by 20px padding.
// On hover the arrow nudges up and right, as on the live site; a keyboard
// focus gets the same nudge plus a visible outline.
import { Button } from '@/components/ui/button';
import { brandButton, buttonTones, focusOutline, type ButtonTone } from './button';
import { accentButton } from './accent';
import type { PillarAccent } from '../data/pillars';

interface Props {
  href: string;
  tone?: ButtonTone;
  // The `accent` tone's Pillar.
  accent?: PillarAccent;
}

const { href, tone = 'dark', accent } = Astro.props;

const brand = 'gap-4 px-5 py-4 text-base leading-none duration-300';
// The arrow's colour: live's Lime on the dark button, until hovered.
const arrows = {
  cta: 'text-cta-arrow group-hover/button:text-current',
  primary: 'text-current',
  dark: 'text-detail group-hover/button:text-current',
  light: 'text-emphasis group-hover/button:text-current',
  outline: 'text-current',
  accent: 'text-current',
};
---

<Button as="a" href={href} class:list={[brandButton, focusOutline, brand, buttonTones[tone], tone === 'accent' && accent && accentButton[accent]]}>
  <slot />
  <span
    aria-hidden="true"
    class:list={[
      'inline-block transition-transform duration-300 group-hover/button:translate-x-0.5 group-hover/button:-translate-y-0.5 group-focus-visible/button:translate-x-0.5 group-focus-visible/button:-translate-y-0.5 rtl:-scale-x-100',
      arrows[tone],
    ]}>↗</span
  >
</Button>
