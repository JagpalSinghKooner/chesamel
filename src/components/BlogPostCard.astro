---
// Blog Post card, as on the live site (#42): the main label as a tag with its
// Pillar accent border, an arrow box, the title, the date and reading time,
// and the hero image across the foot. Built on Fulldev's Card (ADR-0005).
//
// The tag's border and text take the Pillar accent. On hover or keyboard
// focus the card turns white, the tag fills with the accent under white
// text, the arrow box takes the accent and the image grows (not under
// reduced motion). Colours are theme roles (ADR-0006); the date and reading
// time use `body`, since live's grey fails WCAG AA at that size.
import { Card } from '@/components/ui/card';
import Icon from './Icon.astro';
import ImagePlaceholder from './ImagePlaceholder.astro';
import { focusOutline } from './button';
import { brandCard } from './card';
import type { BlogPostSummary } from '../content/blog';
import { formatDate, isoDate, primaryPillar } from '../content/shared';
import { pillarLabels } from '../data/taxonomy';
import { labelAccents } from '../data/pillars';

interface Props {
  post: BlogPostSummary;
  headingLevel?: 'h2' | 'h3' | 'h4' | 'h5';
}

const { post, headingLevel: Heading = 'h3' } = Astro.props;
const label = primaryPillar(post);
const accent = labelAccents[label];
---

<Card
  as="a"
  href={post.address}
  class:list={[
    brandCard,
    focusOutline,
    'group h-full border border-border bg-transparent text-body transition-colors duration-300 hover:bg-panel focus-visible:bg-panel focus-visible:outline-focus',
  ]}
  data-component="blog-post-card"
  data-accent={accent}
>
  <div class="flex grow flex-col px-7 pt-7 pb-4">
    <div class="flex items-start justify-between gap-5">
      <span
        class="border border-pillar px-5 py-3 text-base leading-none font-medium text-pillar-text transition-colors duration-300 group-hover:border-pillar-fill group-hover:bg-pillar-fill group-hover:text-inverse group-focus-visible:border-pillar-fill group-focus-visible:bg-pillar-fill group-focus-visible:text-inverse"
        data-tag
      >{pillarLabels[label]}</span>
      <span aria-hidden="true" class="grid size-11 shrink-0 place-items-center bg-arrow-box transition-colors duration-300 group-hover:bg-pillar group-focus-visible:bg-pillar" data-arrow-box>
        <Icon name="arrow-up-right" class="size-4 rtl:-scale-x-100" />
      </span>
    </div>
    <Heading class="mt-7 text-xl leading-tight font-semibold text-heading">{post.title}</Heading>
    <p class="mt-auto flex justify-between gap-4 pt-12 text-sm leading-none font-semibold">
      <span class="flex items-center gap-1.5">
        <Icon name="calendar" class="size-4.5 text-subtle" />
        <time datetime={isoDate(post.date)}>{formatDate(post.date)}</time>
      </span>
      <span class="flex items-center gap-1.5">
        <Icon name="clock" class="size-4.5 text-subtle" />
        {post.minutes} min
      </span>
    </p>
  </div>
  <div class="aspect-80/37 overflow-hidden">
    {
      post.image ? (
        <img src={post.image.src} alt="" loading="lazy" class="size-full object-cover transition-transform duration-300 group-hover:scale-110 group-focus-visible:scale-110 motion-reduce:transition-none motion-reduce:group-hover:scale-100 motion-reduce:group-focus-visible:scale-100" />
      ) : (
        <ImagePlaceholder />
      )
    }
  </div>
</Card>
