---
// Blog Post card, as on the live site (#42): the main label as a tag with its
// Pillar accent border, an arrow box, the title, the date and reading time,
// and the hero image across the foot. Built on Fulldev's Card (ADR-0005).
//
// On hover or keyboard focus the card turns white, the tag border and the
// arrow box take the Pillar accent and the image grows (not under reduced
// motion). The live site also fills the tag and turns its text white, which
// fails WCAG AA, so the text stays Dark Grey here (ADR-0002).
import { Card } from '@/components/ui/card';
import Icon from './Icon.astro';
import ImagePlaceholder from './ImagePlaceholder.astro';
import { focusOutline } from './button';
import { brandCard } from './card';
import { accentBorder, accentFillOnHover } from './accent';
import type { BlogPostSummary } from '../content/blog';
import { formatDate, isoDate, primaryPillar } from '../content/shared';
import { pillarLabels } from '../data/taxonomy';
import { labelAccents } from '../data/pillars';

interface Props {
  post: BlogPostSummary;
  headingLevel?: 'h2' | 'h3' | 'h4' | 'h5';
}

const { post, headingLevel: Heading = 'h3' } = Astro.props;
const label = primaryPillar(post);
const accent = labelAccents[label];
---

<Card
  as="a"
  href={post.address}
  class:list={[
    brandCard,
    focusOutline,
    'group h-full border border-light-grey bg-transparent text-dark-grey transition-colors duration-300 hover:bg-white focus-visible:bg-white focus-visible:outline-indigo',
  ]}
  data-component="blog-post-card"
>
  <div class="flex grow flex-col px-7 pt-7 pb-4">
    <div class="flex items-start justify-between gap-5">
      <span class:list={['border px-5 py-3 text-base leading-none font-medium', accentBorder[accent]]} data-tag>{pillarLabels[label]}</span>
      <span aria-hidden="true" class:list={['grid size-11 shrink-0 place-items-center bg-light-grey/30 transition-colors duration-300', accentFillOnHover[accent]]} data-arrow-box>
        <Icon name="arrow-up-right" class="size-4 rtl:-scale-x-100" />
      </span>
    </div>
    <Heading class="mt-7 text-xl leading-tight font-semibold text-dark-grey">{post.title}</Heading>
    <p class="mt-auto flex justify-between gap-4 pt-12 text-sm leading-none font-semibold">
      <span class="flex items-center gap-1.5">
        <Icon name="calendar" class="size-4.5 text-grey" />
        <time datetime={isoDate(post.date)}>{formatDate(post.date)}</time>
      </span>
      <span class="flex items-center gap-1.5">
        <Icon name="clock" class="size-4.5 text-grey" />
        {post.minutes} min
      </span>
    </p>
  </div>
  <div class="aspect-80/37 overflow-hidden">
    {
      post.image ? (
        <img src={post.image.src} alt="" loading="lazy" class="size-full object-cover transition-transform duration-300 group-hover:scale-110 group-focus-visible:scale-110 motion-reduce:transition-none motion-reduce:group-hover:scale-100 motion-reduce:group-focus-visible:scale-100" />
      ) : (
        <ImagePlaceholder />
      )
    }
  </div>
</Card>
