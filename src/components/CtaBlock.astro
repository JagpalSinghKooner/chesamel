---
// Call-to-action Component: a dark band with a heading, a line of text, two
// buttons and the brandmark's arcs as a large Indigo watermark (page 9 of the
// brand guidelines allows the brandmark at large scale as a background).
import Logo from '../design-system/Logo.astro';
import Button from './Button.astro';

interface Props {
  heading: string;
  text?: string;
  headingLevel?: 'h2' | 'h3';
  actions: { label: string; href: string; tone: 'dark' | 'indigo' | 'lime' | 'outline' }[];
}

const { heading, text, headingLevel: Heading = 'h2', actions } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-black" data-component="cta">
  <div aria-hidden="true" class="absolute -right-24 -bottom-40 -z-10 opacity-90 sm:-bottom-24">
    <Logo variant="brandmark" colour="indigo" height={360} />
  </div>
  <div class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6">
    <Heading class="type-heading-2 text-white">{heading}</Heading>
    {text && <p class="mt-6 font-subheading text-lg text-off-white">{text}</p>}
    <div class="mt-10 flex flex-wrap justify-center gap-3">
      {actions.map((a) => <Button href={a.href} tone={a.tone}>{a.label}</Button>)}
    </div>
  </div>
</section>
