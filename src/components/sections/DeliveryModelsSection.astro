---
// Delivery Models Section: how Chesamel can work with a client. A Pillar with
// its own models shows them as icon cards; otherwise the shared three show,
// each with its model and detail. Each is a Fulldev Card (ADR-0005), and they
// sit in a Slider, as on the live site.
import { Card } from '@/components/ui/card';
import Slider from '../Slider.astro';
import SliderItem from '../SliderItem.astro';
import { brandCard } from '../card';
import SectionHeading from './SectionHeading.astro';
import { deliveryModels } from '../../data/delivery-models';
import type { Section } from '../../content/page-schemas';

type Props = { id: string; section: Extract<Section, { type: 'deliveryModels' }> };
const { id, section } = Astro.props;
const { heading, eyebrow, text, items } = section;
---

<section data-component="section-delivery-models" aria-labelledby={id} class="bg-black">
  <div class="mx-auto max-w-7xl px-5 py-20 sm:px-6 lg:py-28">
    <SectionHeading id={id} heading={heading} eyebrow={eyebrow} dark />
    {text && <p class="mt-4 max-w-3xl text-off-white">{text}</p>}
    <Slider labelledby={id} tone="dark" class="mt-10">
      {
        items
          ? items.map((item) => (
              <SliderItem class="md:basis-1/2 lg:basis-1/3"><Card class:list={[brandCard, 'h-full gap-4 bg-white p-6 has-[>img:first-child]:pt-6']}>
                {item.image && <img src={item.image.src} alt={item.image.alt} loading="lazy" class="h-14 w-14" />}
                <h3 class="type-heading-3 text-xl">{item.heading}</h3>
                <p>{item.text}</p>
              </Card></SliderItem>
            ))
          : deliveryModels.map((model) => (
              <SliderItem class="md:basis-1/2 lg:basis-1/3"><Card class:list={[brandCard, 'h-full gap-4 border-t-4 border-indigo bg-white p-6']}>
                <h3 class="type-heading-3 text-xl">{model.heading}</h3>
                <p>{model.text}</p>
                <p class="font-subheading text-indigo">/ {model.model}</p>
                <p>{model.detail}</p>
              </Card></SliderItem>
            ))
      }
    </Slider>
  </div>
</section>
