---
// Cards Section: a heading over a grid of cards (capabilities, approach steps,
// benefits, partners). An image, when given, sits beside the grid. A card with
// an address links there. With `layout: slider` the cards sit in a Slider,
// as Our Approach, Why Us and Our Partner Brands do on the live site.
import SectionHeading from './SectionHeading.astro';
import SectionCard from './SectionCard.astro';
import Slider from '../Slider.astro';
import SliderItem from '../SliderItem.astro';
import type { Section } from '../../content/page-schemas';

type Props = { id: string; section: Extract<Section, { type: 'cards' }> };
const { id, section } = Astro.props;
const { heading, eyebrow, text, image, tone, layout, items } = section;
const dark = tone === 'dark';
---

<section data-component="section-cards" aria-labelledby={id} class:list={[{ 'bg-band-dark': dark, 'bg-surface': tone === 'off-white' }]}>
  <div class:list={['mx-auto grid max-w-7xl gap-12 px-5 py-20 sm:px-6 lg:py-28', image && 'lg:grid-cols-[2fr_3fr]']}>
    {image && <img src={image.src} alt={image.alt} loading="lazy" class="hidden h-full w-full object-cover lg:block" />}
    <div class="min-w-0">
      <SectionHeading id={id} heading={heading} eyebrow={eyebrow} dark={dark} />
      {text && <p class:list={['mt-4 max-w-3xl', dark && 'text-body-on-dark']}>{text}</p>}
      {
        layout === 'slider' ? (
          <Slider labelledby={id} tone={dark ? 'dark' : 'light'} class="mt-10">
            {items.map((item) => (
              <SliderItem class:list={['sm:basis-1/2', !image && 'lg:basis-1/3']}>
                <SectionCard as="div" item={item} dark={dark} />
              </SliderItem>
            ))}
          </Slider>
        ) : (
          <ul class:list={['mt-10 grid gap-6', image ? 'sm:grid-cols-2' : 'sm:grid-cols-2 lg:grid-cols-3']}>
            {items.map((item) => <SectionCard item={item} dark={dark} />)}
          </ul>
        )
      }
    </div>
  </div>
</section>
