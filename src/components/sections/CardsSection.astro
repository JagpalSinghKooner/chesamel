---
// Cards Section: a heading over a grid of cards (capabilities, approach steps,
// benefits, partners). An image, when given, sits beside the grid. A card with
// an address links there.
import SectionHeading from './SectionHeading.astro';
import type { Section } from '../../content/page-schemas';

type Props = { id: string; section: Extract<Section, { type: 'cards' }> };
const { id, section } = Astro.props;
const { heading, eyebrow, text, image, tone, items } = section;
const dark = tone === 'dark';
const external = (href: string) => /^https?:/.test(href);
---

<section data-component="section-cards" aria-labelledby={id} class:list={[{ 'bg-black': dark, 'bg-off-white': tone === 'off-white' }]}>
  <div class:list={['mx-auto grid max-w-7xl gap-12 px-4 py-20 sm:px-6', image && 'lg:grid-cols-[2fr_3fr]']}>
    {image && <img src={image.src} alt={image.alt} loading="lazy" class="hidden h-full w-full object-cover lg:block" />}
    <div>
      <SectionHeading id={id} heading={heading} eyebrow={eyebrow} dark={dark} />
      {text && <p class:list={['mt-4 max-w-3xl', dark && 'text-off-white']}>{text}</p>}
      <ul class:list={['mt-10 grid gap-6', image ? 'sm:grid-cols-2' : 'sm:grid-cols-2 lg:grid-cols-3']}>
        {
          items.map((item) => (
            <li class:list={['flex flex-col gap-3 border-t pt-5', dark ? 'border-white/20' : 'border-light-grey']}>
              {item.image && <img src={item.image.src} alt={item.image.alt} loading="lazy" class="h-14 w-auto self-start" />}
              <h3 class:list={['type-heading-3 text-xl', dark && 'text-white']}>
                {item.href ? (
                  <a href={item.href} class="underline-offset-4 hover:underline" {...(external(item.href) && { rel: 'noopener', target: '_blank' })}>
                    {item.heading}
                  </a>
                ) : (
                  item.heading
                )}
              </h3>
              {item.text && <p class:list={[dark && 'text-off-white']}>{item.text}</p>}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
