---
// The "/ eyebrow" line and h2 every Section opens with.
interface Props {
  id: string;
  heading: string;
  eyebrow?: string;
  dark?: boolean;
}
const { id, heading, eyebrow, dark = false } = Astro.props;
---

{eyebrow && <p class:list={['font-subheading', dark && 'text-body-on-dark']}>{eyebrow}</p>}
<h2 id={id} class:list={['type-heading-2', eyebrow && 'mt-3', dark && 'text-inverse']}>{heading}</h2>
