---
// Team Member card: photo, name, "/ role", and LinkedIn and email links when
// the member has them. With `bio`, the bio opens below the card. Built on
// Fulldev's Card (ADR-0005).
import { render } from 'astro:content';
import { Card } from '@/components/ui/card';
import { brandCard } from '../card';
import type { TeamMember } from '../../content/pages';

interface Props {
  member: TeamMember;
  headingLevel?: 'h3' | 'h4';
  bio?: boolean;
}
const { member, headingLevel: Heading = 'h3', bio = false } = Astro.props;
const { name, role, photo, linkedin, email } = member.data;
const { Content } = await render(member);
const hasBio = bio && (member.body ?? '').trim().length > 0;
---

<Card as="article" class:list={[brandCard, 'h-full']} data-component="team-card">
  <img src={photo.src} alt="" loading="lazy" class="aspect-square w-full bg-off-white object-cover" />
  <Heading class="type-heading-3 mt-4 text-xl">{name}</Heading>
  <p class="font-subheading mt-1 text-dark-grey">/ {role}</p>
  {
    (linkedin || email) && (
      <p class="mt-3 flex gap-4 text-sm">
        {linkedin && <a href={linkedin} rel="noopener" target="_blank" class="underline underline-offset-4">LinkedIn<span class="sr-only"> profile of {name} (opens in a new tab)</span></a>}
        {email && <a href={`mailto:${email}`} class="underline underline-offset-4">Email<span class="sr-only"> {name}</span></a>}
      </p>
    )
  }
  {
    hasBio && (
      <details class="mt-3">
        <summary class="cursor-pointer font-subheading">Read full bio<span class="sr-only"> of {name}</span></summary>
        <div class="blog-body mt-3 text-sm"><Content /></div>
      </details>
    )
  }
</Card>
