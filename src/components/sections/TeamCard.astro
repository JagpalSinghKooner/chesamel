---
// Team Member card, as on the live Our Team page (#42): the photo in a thin
// frame with LinkedIn and email icon buttons over its bottom-left corner,
// then the name and "/ role". With `bio`, a "read full bio" expander opens
// the bio below. Built on Fulldev's Card (ADR-0005); the expander is a native
// <details>, so it works without JavaScript.
import { render } from 'astro:content';
import { Card } from '@/components/ui/card';
import Icon from '../Icon.astro';
import { brandCard } from '../card';
import { focusOutline } from '../button';
import type { TeamMember } from '../../content/pages';

interface Props {
  member: TeamMember;
  headingLevel?: 'h3' | 'h4';
  bio?: boolean;
}
const { member, headingLevel: Heading = 'h3', bio = false } = Astro.props;
const { name, role, photo, linkedin, email } = member.data;
const { Content } = await render(member);
const hasBio = bio && (member.body ?? '').trim().length > 0;
const iconButton = [focusOutline, 'grid size-14 place-items-center bg-primary/20 text-emphasis transition-colors duration-300 hover:bg-primary hover:text-inverse focus-visible:outline-focus'];
---

<Card as="article" class:list={[brandCard, 'h-full gap-10 text-body']} data-component="team-card">
  <div class="relative border border-border-strong">
    <img src={photo.src} alt="" loading="lazy" class="aspect-square w-full bg-surface object-cover" />
    {
      (linkedin || email) && (
        <div class="absolute start-3 bottom-3 flex gap-2.5">
          {linkedin && (
            <a href={linkedin} rel="noopener" target="_blank" aria-label={`LinkedIn profile of ${name} (opens in a new tab)`} class:list={iconButton}>
              <Icon name="linkedin" class="size-5.5" />
            </a>
          )}
          {email && (
            <a href={`mailto:${email}`} aria-label={`Email ${name}`} class:list={iconButton}>
              <Icon name="mail" class="size-6" />
            </a>
          )}
        </div>
      )
    }
  </div>
  <div>
    <Heading class="text-2xl leading-8 font-medium text-body">{name}</Heading>
    <p class="mt-1 text-xl font-medium text-emphasis">/ {role}</p>
    {
      hasBio && (
        <details class="group/bio mt-5">
          <summary class="flex cursor-pointer list-none items-center gap-4 text-base leading-none font-medium [&::-webkit-details-marker]:hidden">
            read full bio<span class="sr-only"> of {name}</span>
            <Icon name="chevron-down" class="size-4 transition-transform duration-300 group-open/bio:rotate-180 motion-reduce:transition-none" />
          </summary>
          <div class="blog-body mt-4 text-sm"><Content /></div>
        </details>
      )
    }
  </div>
</Card>
