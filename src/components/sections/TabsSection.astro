---
// Tabs Section: buttons that switch between panels, as What We Do switches
// between the four Pillars. Built on Fulldev's Tabs (ADR-0005), which give the
// tab roles and arrow keys through Data Slot. Without JavaScript every panel
// shows, one after another, and the tab buttons are left out.
import { Tabs, TabsContent, TabsList, TabsTrigger } from '@/components/ui/tabs';
import Button from '../Button.astro';
import SectionHeading from './SectionHeading.astro';
import type { Section } from '../../content/page-schemas';

type Props = { id: string; section: Extract<Section, { type: 'tabs' }> };
const { id, section } = Astro.props;
const { heading, eyebrow, paragraphs, items } = section;
---

<section data-component="section-tabs" aria-labelledby={id} class="bg-off-white">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6">
    <SectionHeading id={id} heading={heading} eyebrow={eyebrow} />
    {paragraphs.map((p) => <p class="mt-6 max-w-3xl">{p}</p>)}
    <Tabs defaultValue="0" class="mt-10 gap-0" data-tabs>
      <TabsList aria-label={heading} class="flex h-auto w-auto flex-wrap justify-start gap-2 rounded-none bg-transparent p-0 text-inherit group-data-horizontal/tabs:h-auto">
        {
          items.map((item, i) => (
            <TabsTrigger
              value={String(i)}
              class="h-auto flex-none whitespace-normal rounded-none border-0 border-b-4 border-transparent px-4 py-3 font-subheading text-[length:inherit] font-normal text-inherit transition-none hover:text-inherit data-[state=active]:border-indigo data-[state=active]:bg-white data-[state=active]:text-inherit group-data-[variant=default]/tabs-list:data-[state=active]:shadow-none"
            >
              {item.title}
            </TabsTrigger>
          ))
        }
      </TabsList>
      {
        items.map((item, i) => (
          <TabsContent value={String(i)} class="mt-8 grid flex-none gap-8 border-t-4 border-indigo bg-white p-8 text-[length:inherit] md:grid-cols-2">
            <div>
              <h3 class="type-heading-3 text-2xl">{item.title}</h3>
              {item.paragraphs.map((p) => <p class="mt-4">{p}</p>)}
              {item.href && <div class="mt-6"><Button href={item.href} tone="dark">Learn more</Button></div>}
            </div>
            {
              item.list.length > 0 && (
                <div>
                  {item.listLabel && <p class="font-subheading">{item.listLabel}</p>}
                  <ul class="mt-4 grid gap-2">
                    {item.list.map((entry) => <li class="border-b border-light-grey pb-2">{entry}</li>)}
                  </ul>
                </div>
              )
            }
          </TabsContent>
        ))
      }
    </Tabs>
  </div>
</section>

<noscript>
  <style is:global>
    /*
      In Tailwind's base layer: its rule hiding [hidden] is !important there,
      and a layered !important beats any unlayered one.
    */
    @layer base {
      [data-tabs] [data-slot='tabs-list'] {
        display: none !important;
      }
      [data-tabs] [data-slot='tabs-content'][hidden] {
        display: grid !important;
      }
    }
  </style>
</noscript>

<script>
  // Data Slot's arrow keys don't follow the reading direction. Right to left,
  // swap them before it sees them, so the left arrow moves to the next tab.
  const swap: Record<string, string> = { ArrowLeft: 'ArrowRight', ArrowRight: 'ArrowLeft' };
  for (const root of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
    root.addEventListener(
      'keydown',
      (event) => {
        const key = swap[event.key];
        const target = event.target as HTMLElement;
        if (!key || !event.isTrusted || getComputedStyle(root).direction !== 'rtl') return;
        event.stopImmediatePropagation();
        event.preventDefault();
        target.dispatchEvent(new KeyboardEvent('keydown', { key, bubbles: true, cancelable: true }));
      },
      { capture: true },
    );
  }
</script>
