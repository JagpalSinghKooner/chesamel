---
// Team Directory Section: every Team Member, with the live Our Team page's
// team filter and 8 to a page (#42). The filter is a Fulldev Toggle Group
// (ADR-0005), in the live order with "All" added last, and starts on
// Founders. "All" keeps the three members with no team reachable.
//
// Filtering and paging happen in the browser within the one page, as on
// live, so the Pager's controls are buttons. Without JavaScript everyone
// shows and the filter and Pager stay hidden.
import { ToggleGroup, ToggleGroupItem } from '@/components/ui/toggle-group';
import TeamCard from './TeamCard.astro';
import SectionHeading from './SectionHeading.astro';
import Pager from '../Pager.astro';
import { getTeamMembers } from '../../content/pages';
import { teamLabels, type TeamSlug } from '../../data/taxonomy';
import type { Section } from '../../content/page-schemas';

type Props = { id: string; section: Extract<Section, { type: 'teamDirectory' }> };
const { id, section } = Astro.props;
const members = await getTeamMembers();
const teams = Object.entries(teamLabels) as [TeamSlug, string][];
const PER_PAGE = 8;
const DEFAULT_TEAM: TeamSlug = 'founders';

// The live site's square filter button: a 65% border-strong outline, Indigo
// when pressed. Live's grey text fails WCAG AA at 16px, so it is the body
// role (ADR-0006).
const filterButton =
  'h-auto min-w-0 cursor-pointer whitespace-normal border border-filter-border px-5 py-3 text-base leading-none font-semibold text-body transition-colors hover:border-primary hover:bg-transparent hover:text-emphasis data-[state=on]:border-primary data-[state=on]:bg-primary data-[state=on]:text-inverse data-[state=on]:hover:text-inverse';
---

<section aria-labelledby={id} data-team-directory data-per-page={PER_PAGE}>
  <div class="mx-auto max-w-7xl px-5 py-20 sm:px-6 lg:py-28">
    <SectionHeading id={id} heading={section.heading} eyebrow={section.eyebrow} />
    {section.text && <p class="mt-4 max-w-3xl">{section.text}</p>}
    <ToggleGroup aria-label="Filter by team" defaultValue={DEFAULT_TEAM} class="mt-8 hidden w-auto flex-wrap gap-3 rounded-none" data-team-filter>
      {
        teams.map(([slug, label]) => (
          <ToggleGroupItem value={slug} class={filterButton}>
            {label}
          </ToggleGroupItem>
        ))
      }
      <ToggleGroupItem value="all" class={filterButton}>All</ToggleGroupItem>
    </ToggleGroup>
    <p class="type-caption mt-6 scroll-mt-28" aria-live="polite" tabindex="-1" data-team-count>{members.length} people</p>
    {/* Says "Page n of m" when the Pager changes the page. */}
    <p aria-live="polite" class="sr-only" data-page-status></p>
    <ul class="mt-6 grid gap-x-6 gap-y-17.5 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {
        members.map((member) => (
          <li data-teams={member.data.teams.join(' ')}>
            <TeamCard member={member} bio />
          </li>
        ))
      }
    </ul>
    <Pager last={Math.ceil(members.length / PER_PAGE)} label="Team pages" hidden data-team-pager />
  </div>
</section>

<script>
  import { createToggleGroup } from '@data-slot/toggle-group';
  import { followReadingDirection } from '../follow-reading-direction';
  import { showPage, onPage, afterPaging } from '../pager';

  for (const root of document.querySelectorAll<HTMLElement>('[data-team-directory]')) {
    const filter = root.querySelector<HTMLElement>('[data-team-filter]')!;
    const pager = root.querySelector<HTMLElement>('[data-team-pager]')!;
    const control = createToggleGroup(filter);
    followReadingDirection(filter);
    const cards = [...root.querySelectorAll<HTMLElement>('[data-teams]')];
    const count = root.querySelector<HTMLElement>('[data-team-count]')!;
    const pageStatus = root.querySelector<HTMLElement>('[data-page-status]')!;
    const perPage = Number(root.dataset.perPage);
    let team = control.value[0];
    let page = 1;
    let last = 1;

    function apply() {
      const matches = cards.filter((card) => team === 'all' || card.dataset.teams!.split(' ').includes(team));
      last = Math.max(1, Math.ceil(matches.length / perPage));
      page = Math.min(page, last);
      const shown = new Set(matches.slice((page - 1) * perPage, page * perPage));
      for (const card of cards) card.hidden = !shown.has(card);
      count.textContent = `${matches.length} ${matches.length === 1 ? 'person' : 'people'}`;
      showPage(pager, page, last);
    }

    filter.classList.replace('hidden', 'flex');
    filter.addEventListener('toggle-group:change', () => {
      // Pressing the chosen team again would leave none pressed: keep it.
      if (control.value.length === 0) return control.setValue(team);
      team = control.value[0];
      page = 1;
      apply();
    });
    onPage(pager, (n) => {
      page = n;
      apply();
      afterPaging(count, pageStatus, page, last);
    });
    apply();
  }
</script>
