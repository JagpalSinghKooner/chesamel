---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"div">

const {
  class: className,
  "data-slot": dataSlot = "carousel-container",
  ...props
} = Astro.props

// Chesamel patch (ADR-0005): the row's offset is on the inline start (-ms-4,
// not -ml-4), so slides line up right to left too.
---

<div
  class="overflow-hidden"
  data-slot="carousel-content"
  data-carousel-viewport
>
  <div
    data-slot={dataSlot}
    class={cn(
      "flex [touch-action:pan-y_pinch-zoom]",
      "group-data-[orientation=vertical]/carousel:-mt-4 group-data-[orientation=vertical]/carousel:[touch-action:pan-x_pinch-zoom] group-data-[orientation=vertical]/carousel:flex-col",
      "group-data-[orientation=horizontal]/carousel:-ms-4",
      className
    )}
    {...props}
  >
    <slot />
  </div>
</div>
