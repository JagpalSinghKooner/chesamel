---
// Case Study slider Component: a heading and a row of Case Study cards that
// slides sideways, one card per view on phones and two from 768px, with the
// live site's controls under it: a progress bar, previous and next buttons and
// a "1 / 3" counter. The live site uses it on Our Work, Industry pages, Case
// Study pages ("Our Related Case Studies") and the Podcast page.
//
// Built on the Slider Component, which works by keyboard, touch and right to
// left, and scrolls natively without JavaScript.
import Slider from './Slider.astro';
import SliderItem from './SliderItem.astro';
import Button from './Button.astro';
import CaseStudyCard from './CaseStudyCard.astro';
import type { CaseStudySummary } from '../content/case-studies';

interface Props {
  caseStudies: CaseStudySummary[];
  heading: string;
  eyebrow?: string;
  text?: string;
  action?: { label: string; href: string };
  // Dark: a Black band with light cards, as on Industry and Case Study pages.
  tone?: 'light' | 'dark';
  headingLevel?: 'h2' | 'h3';
  // Keeps ids unique when a page shows more than one slider.
  id?: string;
}

const { caseStudies, heading, eyebrow, text, action, tone = 'dark', headingLevel: Heading = 'h2', id = 'case-study-slider' } = Astro.props;
const CardHeading = Heading === 'h2' ? 'h3' : 'h4';
const dark = tone === 'dark';
---

<section aria-labelledby={`${id}-heading`} class:list={['case-study-slider', dark ? 'bg-black' : 'bg-off-white']} data-component="case-study-slider">
  <div class="mx-auto max-w-7xl px-5 py-20 sm:px-6 lg:py-28">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        {eyebrow && <p class:list={['font-subheading', dark ? 'text-off-white' : 'text-dark-grey']}>{eyebrow}</p>}
        <Heading id={`${id}-heading`} class:list={['type-heading-2 mt-3', dark && 'text-white']}>{heading}</Heading>
        {text && <p class:list={['mt-4', dark ? 'text-off-white' : 'text-dark-grey']}>{text}</p>}
      </div>
      {action && <Button href={action.href} tone={dark ? 'outline' : 'light'}>{action.label}</Button>}
    </div>
    <Slider labelledby={`${id}-heading`} tone={tone} class="mt-12">
      {
        caseStudies.map((caseStudy) => (
          <SliderItem class="md:basis-1/2">
            <CaseStudyCard caseStudy={caseStudy} headingLevel={CardHeading} />
          </SliderItem>
        ))
      }
    </Slider>
  </div>
</section>
