---
// Case Study slider Component: a heading and a row of Case Study cards that
// slides sideways, one card per view on phones and two from 768px, with the
// live site's controls under it: a progress bar, previous and next buttons and
// a "1 / 3" counter. The live site uses it on Our Work, Industry pages, Case
// Study pages ("Our Related Case Studies") and the Podcast page.
//
// Built on Fulldev's Carousel (Embla), whose copy is patched to work right to
// left (ADR-0005): under dir="rtl" the arrows are mirrored and Next goes left.
// Without JavaScript the cards are an ordinary scrolling row, so they can
// still be swiped or scrolled; the controls appear once the carousel starts.
import { Carousel, CarouselContent, CarouselItem, CarouselNext, CarouselPrevious } from '@/components/ui/carousel';
import Button from './Button.astro';
import CaseStudyCard from './CaseStudyCard.astro';
import type { CaseStudySummary } from '../content/case-studies';

interface Props {
  caseStudies: CaseStudySummary[];
  heading: string;
  eyebrow?: string;
  text?: string;
  action?: { label: string; href: string };
  // Dark: a Black band with light cards, as on Industry and Case Study pages.
  tone?: 'light' | 'dark';
  headingLevel?: 'h2' | 'h3';
  // Keeps ids unique when a page shows more than one slider.
  id?: string;
}

const { caseStudies, heading, eyebrow, text, action, tone = 'dark', headingLevel: Heading = 'h2', id = 'case-study-slider' } = Astro.props;
const CardHeading = Heading === 'h2' ? 'h3' : 'h4';
const dark = tone === 'dark';

// Fulldev's round, floating icon buttons become the brand's square outlined
// ones in the controls row.
const control = [
  'static my-0 size-10 shrink rounded-none bg-transparent text-[length:inherit] font-normal shadow-none hover:bg-transparent active:not-aria-[haspopup]:translate-y-0 disabled:cursor-default disabled:opacity-40',
  dark ? 'border-dark-grey text-white hover:border-white hover:text-white' : 'border-medium-grey text-black hover:border-black hover:text-black',
];
---

<Carousel
  aria-labelledby={`${id}-heading`}
  class:list={['case-study-slider', dark ? 'bg-black' : 'bg-off-white']}
  data-component="case-study-slider"
  data-slider
>
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        {eyebrow && <p class:list={['font-subheading', dark ? 'text-off-white' : 'text-dark-grey']}>{eyebrow}</p>}
        <Heading id={`${id}-heading`} class:list={['type-heading-2 mt-3', dark && 'text-white']}>{heading}</Heading>
        {text && <p class:list={['mt-4', dark ? 'text-off-white' : 'text-dark-grey']}>{text}</p>}
      </div>
      {action && <Button href={action.href} tone={dark ? 'outline' : 'light'}>{action.label}</Button>}
    </div>
    <CarouselContent class="mt-12 pb-4 group-data-[orientation=horizontal]/carousel:-ms-6">
      {
        caseStudies.map((caseStudy) => (
          <CarouselItem class="group-data-[orientation=horizontal]/carousel:ps-6 md:basis-1/2" data-slide>
            <CaseStudyCard caseStudy={caseStudy} headingLevel={CardHeading} />
          </CarouselItem>
        ))
      }
    </CarouselContent>
    <div class="mt-6 flex items-center justify-end gap-4" data-controls hidden>
      <div aria-hidden="true" class:list={['h-0.5 w-full max-w-xs', dark ? 'bg-dark-grey' : 'bg-light-grey']}>
        <div class:list={['h-full transition-[width]', dark ? 'bg-white' : 'bg-black']} data-progress></div>
      </div>
      <CarouselPrevious aria-label="Previous" class:list={control}><span aria-hidden="true" class="inline-block rtl:-scale-x-100" data-arrow>←</span></CarouselPrevious>
      <p class:list={['min-w-12 text-center text-sm font-semibold tabular-nums', dark ? 'text-white' : 'text-black']} data-slide-count>
        1 / {caseStudies.length}
      </p>
      <CarouselNext aria-label="Next" class:list={control}><span aria-hidden="true" class="inline-block rtl:-scale-x-100" data-arrow>→</span></CarouselNext>
    </div>
  </div>
</Carousel>

<style>
  /* Until the carousel starts (or without JavaScript), the row scrolls natively. */
  [data-slider]:not([data-ready]) :global([data-carousel-viewport]) {
    overflow-x: auto;
  }
</style>

<script>
  import type { EmblaCarouselType } from 'embla-carousel';

  // Fulldev's Carousel starts Embla and hands it over on `carousel:init`; this
  // adds the counter and progress bar and shows the controls.
  for (const slider of document.querySelectorAll<HTMLElement & { __fulldevCarouselApi?: EmblaCarouselType }>('[data-slider]')) {
    slider.addEventListener('carousel:init', () => {
      const api = slider.__fulldevCarouselApi!;
      const count = slider.querySelector<HTMLElement>('[data-slide-count]')!;
      const progress = slider.querySelector<HTMLElement>('[data-progress]')!;
      const slides = api.slideNodes().length;

      function update() {
        const engine = api.internalEngine();
        // The first card of the current position: at the end, two cards can
        // share one position.
        const current = engine.slideRegistry[api.selectedScrollSnap()][0];
        count.textContent = `${current + 1} / ${slides}`;
        // How much of the row has been seen, as the bar's share of its track.
        const view = api.rootNode().clientWidth;
        const range = Math.abs(engine.limit.length);
        const seen = view + range * Math.min(1, Math.max(0, api.scrollProgress()));
        progress.style.width = `${range > 0 ? (100 * seen) / (view + range) : 100}%`;
      }

      api.on('select', update).on('scroll', update).on('reInit', update);
      slider.querySelector<HTMLElement>('[data-controls]')!.hidden = false;
      slider.dataset.ready = '';
      update();
    });
  }
</script>
