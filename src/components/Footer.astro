---
// Site footer Component: logo, office cities, links, social icons,
// accreditations, copyright and legal links. Laid out as on the live site,
// except the logo is the tagline lockup: page 11 of the guidelines names the
// website as its use, and the header already carries the plain lockup.
// The social links are Fulldev icon Buttons.
import { Button } from '@/components/ui/button';
import Logo from '../design-system/Logo.astro';
import Icon from './Icon.astro';
import { officeCities, footerLinks, legalLinks, socialLinks, accreditations } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="bg-footer text-footer-text">
  <div class="mx-auto max-w-7xl px-5 py-12 sm:px-6">
    <a href="/" aria-label="Chesamel home" class="-ml-4 inline-block rounded-md focus-visible:outline-2 focus-visible:outline-inverse">
      <Logo variant="tagline-lockup" colour="white" height={40} />
    </a>

    <div class="mt-6 border-t border-footer-rule pt-6">
      <h2 class="type-tag flex items-center gap-2 text-footer-text">
        <span aria-hidden="true" class="inline-block size-1.5 rounded-full bg-footer-marker"></span>
        Global offices
      </h2>
      <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2 font-semibold text-footer-heading">
        {officeCities.map((city) => <li>{city}</li>)}
      </ul>
    </div>

    <div class="mt-6 flex flex-col gap-6 border-t border-footer-rule pt-6 sm:flex-row sm:items-center sm:justify-between">
      <nav aria-label="Footer">
        <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
          {footerLinks.map((link) => <li><a href={link.href} class="hover:text-inverse hover:underline focus-visible:text-inverse focus-visible:underline">{link.label}</a></li>)}
        </ul>
      </nav>
      <ul class="flex gap-3">
        {
          socialLinks.map((s) => (
            <li>
              <Button as="a" href={s.href} aria-label={s.label} size="icon-sm" class="flex rounded-md border-0 bg-footer-social transition-none hover:bg-footer-rule focus-visible:bg-footer-rule active:not-aria-[haspopup]:translate-y-0">
                <Icon name={s.icon} class="size-4 text-detail" />
              </Button>
            </li>
          ))
        }
      </ul>
    </div>

    <ul class="mt-6 flex flex-wrap items-center gap-x-10 gap-y-4">
      {
        accreditations.map((a) => (
          <li>
            <a href={a.href} aria-label={a.label} class="block opacity-70 hover:opacity-100 focus-visible:opacity-100">
              <img src={a.image} alt="" width={a.width} height={a.height} class="h-10 w-auto" loading="lazy" />
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-6 flex flex-col gap-4 border-t border-footer-rule pt-6 text-xs lg:flex-row lg:justify-between">
      <p>© {year} Chesamel Group Ltd. All rights reserved.</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        {legalLinks.map((link) => <li><a href={link.href} class="hover:text-inverse hover:underline focus-visible:text-inverse focus-visible:underline">{link.label}</a></li>)}
      </ul>
    </div>
  </div>
</footer>
