---
// Breadcrumb Component: "Home / Insights / Our Work", built on Fulldev's
// Breadcrumb (ADR-0005). Each step with an `href` is a link; a final step
// without one is the current page and is marked `aria-current="page"`.
//
// `band` gives it its own full-width strip with a rule under it, as below the
// hero on Our Work, Industry and Case Study pages; otherwise it sits inline
// in whatever holds it.
import type { Trail } from './trails';
import { Breadcrumb, BreadcrumbItem, BreadcrumbLink, BreadcrumbList, BreadcrumbPage, BreadcrumbSeparator } from '@/components/ui/breadcrumb';

interface Props {
  trail: Trail;
  band?: boolean;
  class?: string;
}

const { trail, band = false, class: className } = Astro.props;
const last = trail.length - 1;
---

<Breadcrumb aria-label="Breadcrumb" class:list={['type-caption lg:text-base', band && 'border-b border-light-grey', className]}>
  {/* Text keeps the colour of whatever holds it (white on a dark hero). */}
  <BreadcrumbList class:list={['gap-2 text-[length:inherit] text-inherit sm:gap-2', band && 'mx-auto max-w-7xl px-5 py-4 sm:px-6 lg:py-5']}>
    {
      trail.map((step, i) => (
        <>
          <BreadcrumbItem class="gap-0">
            {step.href ? (
              <BreadcrumbLink href={step.href} class="underline decoration-transparent underline-offset-4 transition-colors duration-300 hover:text-inherit hover:decoration-current focus-visible:decoration-current">
                {step.label}
              </BreadcrumbLink>
            ) : i === last ? (
              <BreadcrumbPage class="text-inherit">{step.label}</BreadcrumbPage>
            ) : (
              step.label
            )}
          </BreadcrumbItem>
          {/* Sits a space's width after its step, as "Home /" did. */}
          {i < last && <BreadcrumbSeparator class="-ms-2">{'\u00a0/'}</BreadcrumbSeparator>}
        </>
      ))
    }
  </BreadcrumbList>
</Breadcrumb>
