---
// Breadcrumb Component: "Home / Insights / Our Work". Each step with an
// `href` is a link; a final step without one is the current page and is
// marked `aria-current="page"`.
//
// `band` gives it its own full-width strip with a rule under it, as below the
// hero on Our Work, Industry and Case Study pages; otherwise it sits inline
// in whatever holds it.
interface Props {
  trail: { label: string; href?: string }[];
  band?: boolean;
  class?: string;
}

const { trail, band = false, class: className } = Astro.props;
const last = trail.length - 1;
---

<nav aria-label="Breadcrumb" class:list={['type-caption', band && 'border-b border-light-grey', className]}>
  <ol class:list={['flex flex-wrap gap-2', band && 'mx-auto max-w-7xl px-4 py-4 sm:px-6']}>
    {
      trail.map((step, i) =>
        step.href ? (
          <li>
            <a href={step.href} class="underline">
              {step.label}
            </a>
            {i < last && ' /'}
          </li>
        ) : (
          <li aria-current={i === last ? 'page' : undefined}>
            {step.label}
            {i < last && ' /'}
          </li>
        ),
      )
    }
  </ol>
</nav>
