---
// Latest Insights on the homepage: the three newest Blog Posts.
import { Button as FulldevButton } from '@/components/ui/button';
import Button from '../Button.astro';
import { brandButton } from '../button';
import BlogPostCard from '../BlogPostCard.astro';
import { getBlogPosts, summarisePost } from '../../content/blog';

// The live site also links /insights/news/, which returns 404 there; News is
// served at /insights/blog/, so it is listed once, as News.
const filters = [
  { label: 'News', href: '/insights/blog/' },
  { label: 'Podcasts', href: '/insights/podcasts/' },
  { label: 'Reports', href: '/insights/reports/' },
  { label: 'Webinar', href: '/insights/webinars/' },
];

const insights = (await getBlogPosts()).slice(0, 3).map(summarisePost);
---

<section class="bg-off-white" aria-labelledby="latest-insights">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
      <h2 id="latest-insights" class="type-heading-2">Latest Insights</h2>
      <ul class="flex flex-wrap gap-2">
        {filters.map((f) => <li><FulldevButton as="a" href={f.href} class:list={[brandButton, 'block border-light-grey bg-transparent px-3 py-2 text-inherit transition-none hover:border-dark-grey hover:bg-transparent hover:text-inherit']}>{f.label}</FulldevButton></li>)}
        <li><Button href="/insights/" tone="light">All Insights</Button></li>
      </ul>
    </div>
    <ul class="mt-12 grid gap-4 md:grid-cols-3">
      {insights.map((post) => <li><BlogPostCard post={post} /></li>)}
    </ul>
  </div>
</section>
