---
// "What's holding your business back?" with the three numbered steps.
// Each step's last words take their own colour on a raised dark card, as on
// live (theme roles, ADR-0006; the brand palette sets them white with an
// Indigo underline).
//
// On phones the steps slide one at a time, as on the live site; from 640px all
// three fit, so the slider's controls hide.
import Button from '../Button.astro';
import Slider from '../Slider.astro';
import SliderItem from '../SliderItem.astro';
import { contactLink } from '../../data/site';

const steps = [
  { tag: '/ change', lead: 'Evolving the', accent: 'way you work', colour: 'text-step-1', text: 'We get to know your business in depth, so we can plan your unique transformation.' },
  { tag: '/ innovate', lead: 'Going beyond the', accent: 'status quo', colour: 'text-step-2', text: 'We help you think outside your current limitations, and show you how to overcome these.' },
  { tag: '/ improve', lead: 'Finding the right', accent: 'solution', colour: 'text-step-3', text: 'We optimise our solutions in real-time, growing our offering as your business grows.' },
];
---

<section class="bg-band-dark" aria-labelledby="holding-back">
  <div class="mx-auto grid max-w-7xl gap-12 px-5 py-20 sm:px-6 lg:py-28 lg:grid-cols-[1fr_2fr] lg:items-center">
    <div>
      <h2 id="holding-back" class="type-heading-2 text-inverse">What’s holding your business back?</h2>
      <div class="mt-8"><Button href={contactLink.href} tone="outline">{contactLink.label}</Button></div>
    </div>
    <Slider labelledby="holding-back" tone="dark" class="min-w-0">
      {
        steps.map((s, i) => (
          <SliderItem class="basis-[85%] sm:basis-1/3"><div class="relative h-full bg-band-dark-raised p-6 pt-16">
            <span aria-hidden="true" class="absolute top-0 right-0 bg-step-number px-3 py-2 text-xl font-medium text-muted-on-dark">
              {String(i + 1).padStart(2, '0')}
            </span>
            <p class="text-sm text-muted-on-dark">{s.tag}</p>
            <h3 class="type-heading-3 mt-2 text-inverse">
              {s.lead} <span class:list={['underline decoration-step-underline decoration-4 underline-offset-4', s.colour]}>{s.accent}</span>
            </h3>
            <p class="mt-3 text-sm text-muted-on-dark">{s.text}</p>
          </div></SliderItem>
        ))
      }
    </Slider>
  </div>
</section>
