---
// "What's holding your business back?" with the three numbered steps.
import Button from '../Button.astro';

const steps = [
  { tag: '/ change', lead: 'Evolving the', accent: 'way you work', colour: 'text-sky', text: 'We get to know your business in depth, so we can plan your unique transformation.' },
  { tag: '/ innovate', lead: 'Going beyond the', accent: 'status quo', colour: 'text-mint', text: 'We help you think outside your current limitations, and show you how to overcome these.' },
  { tag: '/ improve', lead: 'Finding the right', accent: 'solution', colour: 'text-fuchsia', text: 'We optimise our solutions in real-time, growing our offering as your business grows.' },
];
---

<section class="bg-black">
  <div class="mx-auto grid max-w-7xl gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[1fr_2fr] lg:items-center">
    <div>
      <h2 class="type-heading-2 text-white">What’s holding your business back?</h2>
      <div class="mt-8"><Button href="/contact/" tone="outline">Let’s Talk</Button></div>
    </div>
    <ol class="grid gap-4 sm:grid-cols-3">
      {
        steps.map((s, i) => (
          <li class="relative bg-white/5 p-6 pt-16">
            <span aria-hidden="true" class="absolute top-0 right-0 bg-black/60 px-3 py-2 text-xl font-medium text-medium-grey">
              {String(i + 1).padStart(2, '0')}
            </span>
            <p class="text-sm text-medium-grey">{s.tag}</p>
            <h3 class="mt-2 text-xl font-medium text-white">
              {s.lead} <span class={s.colour}>{s.accent}</span>
            </h3>
            <p class="mt-3 text-sm text-off-white">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
