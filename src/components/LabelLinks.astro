---
// "Industry served" and "Services provided": bordered links to each label's
// page, as on the live Blog Post, Case Study, webinar and report pages.
// Either list may be empty, and an empty list isn't shown.
//
// By default each list sits under the content with a rule above it; in a
// side column (`placement="column"`) it stacks the links one per row instead.
import { pillarLabels, industryLabels, type PillarSlug, type IndustrySlug } from '../data/taxonomy';

interface Props {
  pillars?: PillarSlug[];
  industries?: IndustrySlug[];
  servicesHeading?: string;
  placement?: 'below' | 'column';
}

const { pillars = [], industries = [], servicesHeading = 'Services provided', placement = 'below' } = Astro.props;
const below = placement === 'below';
const groups = [
  { id: 'industry-served', heading: 'Industry served', cta: 'Explore industry', links: industries.map((s) => ({ href: `/industries/${s}/`, label: industryLabels[s] })) },
  { id: 'services-provided', heading: servicesHeading, cta: 'Explore service', links: pillars.map((s) => ({ href: `/services/${s}/`, label: pillarLabels[s] })) },
].filter((g) => g.links.length);
---

{
  groups.map((g) => (
    <aside aria-labelledby={g.id} class:list={[below && 'mt-16 border-t border-light-grey pt-8']} data-component="label-links">
      <h2 id={g.id} class="type-tag">
        {g.heading}
      </h2>
      <ul class:list={['mt-4 grid gap-3', below && 'sm:grid-cols-2']}>
        {g.links.map((l) => (
          <li>
            <a href={l.href} class="flex items-center justify-between gap-4 border border-light-grey px-4 py-5 font-semibold text-black hover:bg-off-white">
              {l.label}
              <span class="type-caption shrink-0">
                {g.cta} <span aria-hidden="true">↗</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </aside>
  ))
}
