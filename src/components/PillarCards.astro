---
// Pillar cards Component: the four Pillars as linked cards, beside an
// optional introduction (the live homepage's "How we add value"). Each card is
// a Fulldev Card (ADR-0005).
//
// As on live (#42): from 768px, square tiles two across with the
// illustration over the name; on phones, rows with the illustration, the name
// and an arrow box. A hovered or focused tile fills with its Pillar accent
// under white text and shows its summary, as on live: the `-fill` role,
// darkened so the text passes WCAG AA (ADR-0006). The summary is otherwise
// visually hidden but still read out as part of the link.
import { Card } from '@/components/ui/card';
import Icon from './Icon.astro';
import { brandCard } from './card';
import { focusOutline } from './button';
import { accentFillOnOwnHover } from './accent';
import { pillars } from '../data/pillars';

interface Props {
  headingLevel?: 'h2' | 'h3';
}

const { headingLevel: Heading = 'h2' } = Astro.props;
const CardHeading = Heading === 'h2' ? 'h3' : 'h4';
---

<section class="bg-surface" data-component="pillar-cards">
  <div class="mx-auto grid max-w-7xl gap-12 px-5 py-20 sm:px-6 lg:py-28 lg:grid-cols-[3fr_2fr] lg:items-center">
    <ul aria-label="Pillars" class="grid gap-5 md:grid-cols-2">
      {
        pillars.map((p) => (
          <li>
            <Card
              as="a"
              href={p.href}
              class:list={[
                brandCard,
                focusOutline,
                'group h-full flex-row items-center gap-5 border border-border-strong/60 px-4 py-4.5 text-heading transition-colors duration-300 focus-visible:outline-focus md:aspect-square md:flex-col md:justify-center md:text-center',
                accentFillOnOwnHover[p.accent],
              ]}
              data-component="pillar-card"
            >
              <img src={p.icon} alt="" width="100" height="100" loading="lazy" class="m-2.5 size-12 shrink-0 md:m-3 md:size-19" />
              <div class="grow md:grow-0">
                <CardHeading class="text-lg font-semibold">{p.label}</CardHeading>
                <p class="type-caption text-current sr-only md:group-hover:not-sr-only md:group-hover:mt-2 md:group-focus-visible:not-sr-only md:group-focus-visible:mt-2">{p.summary}</p>
              </div>
              <span aria-hidden="true" class="grid size-11 shrink-0 place-items-center bg-border-strong/20 md:hidden">
                <Icon name="arrow-up-right" class="size-4 rtl:-scale-x-100" />
              </span>
            </Card>
          </li>
        ))
      }
    </ul>
    <div>
      <slot />
    </div>
  </div>
</section>
