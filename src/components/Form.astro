---
// Contact and newsletter forms (issue #11): the live HubSpot forms' fields,
// wording and layout as native, accessible fields. Nothing is sent yet: a
// valid submit shows the success message, and #48 fills in `sendForm`
// (./form.ts) to post to HubSpot.
//
//   contact:    the Contact hero's form, on a light surface
//   newsletter: the newsletter band's form, on Indigo
//
// Each label is hidden and the placeholder shows in the field, as on the live
// site; screen readers still read the label. Errors are white text on a Rose
// fill, as on live, at 12px rather than live's 10px; the fill is the
// `error-fill` role, darkened so the text passes WCAG AA (ADR-0006). The
// field's border marks it too. The newsletter's fields fill at 5% white, not
// live's 10%, under which white text fails AA (#11).
//
// Submit buttons start disabled and ./form.ts enables them, so without
// JavaScript (or before it runs) a submit goes nowhere: the form has no method
// or action, and a disabled default button blocks Enter too.
//
// The success box is an empty live region; the script fills it from its
// <template> once the form is sent, so screen readers announce the message.
//
// `preview` shows a state without typing, for the style guide.
import { Button } from '@/components/ui/button';
import { brandButton, focusOutline } from './button';
import { contactForm, newsletterForm, formMessages, type ConsentText } from '../data/forms';

interface Props {
  kind: 'contact' | 'newsletter';
  // Prefixes every id, so one page can show a form more than once.
  idPrefix?: string;
  preview?: 'errors' | 'success';
}
const { kind, idPrefix = kind, preview } = Astro.props;
const form = kind === 'contact' ? contactForm : newsletterForm;
const indigo = kind === 'newsletter';
const id = `${idPrefix}-form`;
const showErrors = preview === 'errors';

const tone = indigo
  ? {
      input: 'border-2 border-transparent bg-field-on-indigo py-3.5 text-base leading-6 text-inverse placeholder:text-inverse aria-invalid:border-detail lg:text-lg lg:leading-7 focus-visible:outline-inverse',
      error: 'bg-error-fill px-2 py-1 text-inverse',
      consent: 'bg-field-on-indigo px-4.5 py-3.5 text-inverse',
      checkbox: 'accent-checkbox-on-indigo focus-visible:outline-inverse',
      link: 'text-inverse',
    }
  : {
      input: 'border border-border bg-field py-3.5 text-lg leading-7 text-heading placeholder:text-body aria-invalid:border-error aria-invalid:ring-1 aria-invalid:ring-error focus-visible:outline-focus',
      error: 'bg-error-fill px-2 py-1 text-error-foreground',
      consent: 'text-body',
      checkbox: 'accent-checkbox focus-visible:outline-focus',
      link: 'text-body',
    };

// Splits a consent text around its linked word.
const parts = ({ text, link }: ConsentText) => {
  if (!link) return { before: text, link: undefined, after: '' };
  const at = text.indexOf(link.word);
  return { before: text.slice(0, at), link, after: text.slice(at + link.word.length) };
};
const label = parts(form.consent.label);
const notes = form.consent.notes.map(parts);

const submitClass = indigo
  ? 'w-full justify-between gap-4 border-0 bg-button-dark px-6.5 py-4 text-base leading-6 text-button-dark-foreground hover:bg-button-dark-hover hover:text-button-dark-hover-foreground focus-visible:outline-inverse lg:text-lg lg:leading-7'
  : 'w-full justify-center border-0 bg-primary px-6.5 py-3.5 text-base leading-6 text-primary-foreground hover:bg-primary-hover focus-visible:outline-focus sm:w-56 sm:shrink-0 sm:text-lg sm:leading-7';
---

<form
  id={id}
  data-form={kind}
  data-hubspot-form={form.hubspotFormId}
  hidden={preview === 'success'}
  class:list={['grid', indigo ? 'gap-3' : 'gap-7']}
>
  <div class:list={['grid sm:grid-cols-2', indigo ? 'gap-3' : 'gap-3.5']}>
    {
      form.fields.map((field) => {
        const inputId = `${idPrefix}-${field.name}`;
        const invalid = showErrors && field.required;
        return (
          <div class:list={[field.wide && 'sm:col-span-2']}>
            <label for={inputId} class="sr-only">
              {field.label}
            </label>
            <div class="relative">
              {indigo && field.required && (
                <span aria-hidden="true" class="pointer-events-none absolute start-5 top-1/2 -translate-y-1/2 font-semibold text-detail lg:text-lg">
                  *
                </span>
              )}
              <input
                id={inputId}
                name={field.name}
                type={field.type}
                autocomplete={field.autocomplete}
                placeholder={field.placeholder}
                required={field.required}
                aria-describedby={`${inputId}-error`}
                aria-invalid={invalid ? 'true' : undefined}
                data-field
                class:list={['block w-full px-8 font-semibold', focusOutline, tone.input]}
              />
            </div>
            <p id={`${inputId}-error`} hidden={!invalid} class:list={['mt-1 text-xs font-medium', tone.error]}>
              {invalid ? formMessages.required : ''}
            </p>
          </div>
        );
      })
    }
    {
      indigo && (
        <div class="sm:col-start-2">
          <Button type="submit" disabled data-form-submit class:list={[brandButton, focusOutline, submitClass]}>
            {form.submitLabel}
            <span aria-hidden="true" class="text-detail group-hover/button:text-current rtl:-scale-x-100">↗</span>
          </Button>
        </div>
      )
    }
  </div>

  <div class:list={[!indigo && 'flex flex-col gap-7 sm:flex-row sm:items-start sm:justify-between sm:gap-10']}>
    <div class:list={['text-xs font-medium', tone.consent]}>
      <div class="flex items-center gap-4">
        <input
          id={`${idPrefix}-consent`}
          name={form.consent.name}
          type="checkbox"
          value="true"
          class:list={['size-5.5 shrink-0', focusOutline, tone.checkbox]}
        />
        <label for={`${idPrefix}-consent`}>
          {label.before}
          {label.link && <a href={label.link.href} class:list={['underline', tone.link]}>{label.link.word}</a>}
          {label.after}
        </label>
      </div>
      <div class:list={['mt-3 grid gap-1', !indigo && 'ps-10']}>
        {
          notes.map((note) => (
            <p>
              {note.before}
              {note.link && <a href={note.link.href} class:list={['underline', tone.link]}>{note.link.word}</a>}
              {note.after}
            </p>
          ))
        }
      </div>
    </div>
    {
      !indigo && (
        <Button type="submit" disabled data-form-submit class:list={[brandButton, focusOutline, submitClass]}>
          {form.submitLabel}
        </Button>
      )
    }
  </div>

  <p data-form-summary hidden={!showErrors} class:list={['text-xs font-medium', tone.error]}>{formMessages.summary}</p>
</form>

<div
  id={`${id}-success`}
  aria-live="polite"
  tabindex="-1"
  data-form-success
  class:list={['grid gap-2 text-lg font-semibold', focusOutline, indigo ? 'text-inverse focus-visible:outline-inverse' : 'text-heading focus-visible:outline-focus']}
>
  {preview === 'success' && form.success.map((p) => <p>{p}</p>)}
  <template>{form.success.map((p) => <p>{p}</p>)}</template>
</div>

<script>
  import { enhance } from './form';
  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-form]')) enhance(form);
</script>
