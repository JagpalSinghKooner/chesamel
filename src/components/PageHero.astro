---
// Page hero Component: the title band at the top of a Page, Pillar or
// Service, with its subtitle, paragraphs, facts (such as a role's "Hybrid /
// Full-Time") and buttons, and the brandmark rings turning in its corner.
//
// Two tones, as on the live site:
//   brand:  most Pages, Indigo with white text and faint white rings
//   light:  Pillars, Services, Contact and open roles. Pillars and Services
//           pass their `accent`: the rings and the last button take it, as
//           live's pink, blue and orange (ADR-0006).
import Button from './Button.astro';
import BrandmarkRings from './BrandmarkRings.astro';
import type { PillarAccent } from '../data/pillars';

interface Props {
  title: string;
  eyebrow?: string;
  subtitle?: string;
  paragraphs?: string[];
  details?: string[];
  links?: { label: string; href: string }[];
  tone?: 'brand' | 'light';
  // Light tone only: the Pillar accent of a Pillar or Service.
  accent?: PillarAccent;
  // Live has no rings on an open role's hero.
  rings?: boolean;
  // h1 on a page; lower where the hero is shown as a sample.
  headingLevel?: 'h1' | 'h4';
}
const { title, eyebrow, subtitle, paragraphs = [], details = [], links = [], tone = 'brand', accent, rings = true, headingLevel: Heading = 'h1' } = Astro.props;
const indigo = tone === 'brand';
// The buttons' tones: one stands out (`lead`, first or last) and the rest share a tone.
const buttonTones = {
  // An Indigo hero: an outline button, then dark ones.
  brand: { lead: 'outline', rest: 'dark', leadIsLast: false },
  // A Pillar's or Service's hero: light buttons, the last filled with its accent.
  accent: { lead: 'accent', rest: 'light', leadIsLast: true },
  // Any other light hero: Indigo, then light.
  light: { lead: 'primary', rest: 'light', leadIsLast: false },
} as const;
const kind = buttonTones[indigo ? 'brand' : accent ? 'accent' : 'light'];
const isLead = (i: number) => i === (kind.leadIsLast ? links.length - 1 : 0);
// The `aside` slot sits beside the text from 1024px, under it on smaller
// screens: Contact's form.
const hasAside = Astro.slots.has('aside');
---

<section data-component="page-hero" data-tone={tone} class:list={['relative isolate overflow-hidden', indigo ? 'bg-band-indigo text-inverse' : 'bg-surface']}>
  {
    rings && (
      <BrandmarkRings
        on={indigo ? 'brand' : 'light'}
        accent={indigo ? undefined : accent}
        class="absolute -end-32 -bottom-48 -z-10 size-96 opacity-90 sm:size-136 lg:-end-16 lg:-bottom-56 lg:size-176"
      />
    )
  }
  <div class:list={['mx-auto max-w-7xl px-5 py-20 sm:px-6 lg:py-32', hasAside && 'lg:grid lg:grid-cols-2 lg:items-center lg:gap-4']}>
    <div class="max-w-4xl">
      {eyebrow && <p class="font-subheading">{eyebrow}</p>}
      <Heading class:list={['type-heading-1 text-5xl sm:text-6xl lg:text-7xl', eyebrow && 'mt-3', indigo ? 'text-inverse' : accent && 'text-hero-title']}>{title}</Heading>
      {subtitle && <p class:list={['type-subheading mt-6 text-xl lg:text-2xl', indigo && 'text-inverse']}>{subtitle}</p>}
      {paragraphs.map((p, i) => <p class:list={[i === 0 ? 'mt-6 text-lg lg:text-xl' : 'mt-4', 'max-w-3xl']}>{p}</p>)}
      {details.length > 0 && <p class:list={['font-subheading mt-6 flex flex-wrap gap-x-6 gap-y-2', !indigo && 'text-body']}>{details.map((d) => <span>{d}</span>)}</p>}
      {
        links.length > 0 && (
          <div class="mt-10 flex flex-wrap gap-3">
            {links.map((link, i) => (
              isLead(i) && kind.lead === 'accent' && accent ? (
                <Button href={link.href} tone="accent" accent={accent}>{link.label}</Button>
              ) : (
                <Button href={link.href} tone={isLead(i) && kind.lead !== 'accent' ? kind.lead : kind.rest}>{link.label}</Button>
              )
            ))}
          </div>
        )
      }
    </div>
    {hasAside && <div class="mt-12 lg:mt-0"><slot name="aside" /></div>}
  </div>
</section>
