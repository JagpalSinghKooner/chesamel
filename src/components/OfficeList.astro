---
// Office list Component: every Office with its address and, where it has
// one, its phone number as a tap-to-call link. The first Office (London, the
// head office) leads in a wide card, as on the live contact page. Each Office
// is a Fulldev Card (ADR-0005).
import { Card, CardContent } from '@/components/ui/card';
import { brandCard, brandCardContent } from './card';
import { getOffices } from '../content/pages';

interface Props {
  headingLevel?: 'h2' | 'h3';
}
const { headingLevel: Heading = 'h3' } = Astro.props;
const offices = await getOffices();
const tel = (phone: string) => `tel:${phone.replace(/[^+\d]/g, '')}`;
---

<ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-office-list data-component="office-list">
  {
    offices.map((office, i) => (
      <Card as="li" class:list={[brandCard, 'border border-light-grey bg-white', i === 0 && 'md:col-span-2 lg:col-span-3 lg:flex-row']} data-office={office.data.country}>
        {office.data.image && (
          <img src={office.data.image.src} alt={office.data.image.alt} loading="lazy" class:list={['aspect-[21/10] w-full object-cover', i === 0 && 'lg:w-1/2']} />
        )}
        <CardContent class:list={[brandCardContent, 'flex-1 gap-3 p-6']}>
          <Heading class="type-heading-3 text-xl">{office.data.name}</Heading>
          {office.body?.trim() && <p>{office.body.trim()}</p>}
          <address class="not-italic">
            {office.data.address.map((line) => (
              <span class="block">{line}</span>
            ))}
          </address>
          {office.data.phone && (
            <p>
              <a href={tel(office.data.phone)} class="underline underline-offset-4">
                {office.data.phone}
              </a>
            </p>
          )}
          {office.data.directions && (
            <p>
              <a href={office.data.directions} rel="noopener" target="_blank" class="font-subheading underline underline-offset-4">
                Get Directions<span class="sr-only"> to {office.data.name} (opens in a new tab)</span>
              </a>
            </p>
          )}
        </CardContent>
      </Card>
    ))
  }
</ul>
