---
// Office list Component: every Office with its address and, where it has
// one, its phone number as a tap-to-call link. The first Office (London, the
// head office) leads in a wide card, as on the live contact page, and the
// others follow in a Slider. Each Office is a Fulldev Card (ADR-0005).
import Slider from './Slider.astro';
import SliderItem from './SliderItem.astro';
import OfficeCard from './OfficeCard.astro';
import { getOffices } from '../content/pages';

interface Props {
  headingLevel?: 'h2' | 'h3';
}
const { headingLevel = 'h3' } = Astro.props;
const [first, ...rest] = await getOffices();
---

<div class="flex flex-col gap-6" data-office-list data-component="office-list">
  <OfficeCard office={first} lead headingLevel={headingLevel} />
  <Slider label="Other offices">
    {rest.map((office) => <SliderItem class="md:basis-1/2 lg:basis-1/3"><OfficeCard office={office} headingLevel={headingLevel} /></SliderItem>)}
  </Slider>
</div>
