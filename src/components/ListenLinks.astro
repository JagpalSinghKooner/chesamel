---
// "/ listen now on": a Podcast episode's links to each platform that has it.
// `episode` names the episode for screen readers, since a listing repeats
// the platform names once per episode. Each link is a Fulldev Button.
import { Button } from '@/components/ui/button';
import { brandButton } from './button';
import type { PodcastData } from '../content/insight-schemas';

interface Props {
  listen: PodcastData['listen'];
  episode: string;
}

const { listen, episode } = Astro.props;
const names = { spotify: 'Spotify', amazon: 'Amazon Music', podcastAddict: 'Podcast Addict', podchaser: 'Podchaser' } as const;
const links = (Object.keys(names) as (keyof typeof names)[]).filter((k) => listen[k]).map((k) => ({ href: listen[k]!, name: names[k] }));
---

<div class="flex flex-wrap items-center gap-x-4 gap-y-2">
  <p class="type-caption">/ listen now on</p>
  <ul class="flex flex-wrap gap-2">
    {
      links.map((l) => (
        <li>
          <Button as="a" href={l.href} class:list={[brandButton, 'gap-0 border-light-grey bg-transparent px-3 py-1.5 text-black transition-none hover:border-indigo hover:bg-transparent']} rel="noopener">
            {l.name}
            <span class="sr-only">: {episode}</span>
          </Button>
        </li>
      ))
    }
  </ul>
</div>
