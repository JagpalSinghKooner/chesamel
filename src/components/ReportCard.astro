---
// Report card, as on the live Reports listing (#42): a tile filled with the
// accent of the Report's main label, with the white wordmark top left, the
// brandmark top right, the white title, "/ read report →", and the Report's
// cover as a circle cut off at the bottom right. The fill is the `-fill`
// role, darkened from live's accent so white text passes WCAG AA (ADR-0006).
//
// On hover or keyboard focus the cover grows a little (not under reduced
// motion). The cover is decorative: the title names the link.
import Icon from './Icon.astro';
import Logo from '../design-system/Logo.astro';
import { focusOutline } from './button';
import { accentTile } from './accent';
import { labelAccents } from '../data/pillars';
import type { PillarSlug } from '../data/taxonomy';

interface Props {
  href: string;
  title: string;
  image: { src: string; alt: string };
  pillar: PillarSlug;
  headingLevel?: 'h2' | 'h3' | 'h4';
}

const { href, title, image, pillar, headingLevel: Heading = 'h3' } = Astro.props;
---

<a
  href={href}
  class:list={[focusOutline, 'group relative isolate flex h-full min-h-65 flex-col gap-11 overflow-hidden pt-4 pe-4 pb-5.5 ps-7 text-inverse focus-visible:outline-focus', accentTile[labelAccents[pillar]]]}
  data-accent={labelAccents[pillar]}
  data-component="report-card"
>
  {/* The logos carry their clear space as padding; the negative margins line their marks up with the edges, as on live. */}
  <div class="-mt-2 -me-2 flex items-start justify-between gap-3">
    <span class="-ms-2.5"><Logo variant="wordmark" colour="white" height={14} /></span>
    <Logo variant="brandmark" colour="white" height={40} />
  </div>
  <Heading class="w-1/2 text-xl leading-tight font-medium text-inverse">{title}</Heading>
  <p class="mt-auto flex items-center gap-4 text-sm leading-none font-medium">
    / read report
    <Icon name="arrow-right" class="size-5 rtl:-scale-x-100" />
  </p>
  <div class="absolute -end-5 -bottom-8 -z-10 size-36 overflow-hidden rounded-full lg:size-40">
    <img src={image.src} alt="" loading="lazy" class="size-full object-cover transition-transform duration-300 group-hover:scale-110 group-focus-visible:scale-110 motion-reduce:transition-none motion-reduce:group-hover:scale-100 motion-reduce:group-focus-visible:scale-100" />
  </div>
</a>
