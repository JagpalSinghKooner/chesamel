---
// Icon: the only way to show an icon (ADR-0005, Toolkit). `name` picks one
// from src/design-system/icons.ts. Colour comes from currentColor; size from
// the classes passed (24px if none set it).
//
// Icons are decorative and hidden from screen readers, unless given a
// `label`, which names the icon itself (not a link around it: a link gets its
// own aria-label).
import type { HTMLAttributes } from 'astro/types';
import { brandIcons, interfaceIcons, type IconName } from '../design-system/icons';

interface Props extends Omit<HTMLAttributes<'svg'>, 'aria-label' | 'aria-hidden' | 'role' | 'name'> {
  name: IconName;
  label?: string;
  // Fills a Lucide outline (pause, play, triangle). Brand logos are always solid.
  filled?: boolean;
  'stroke-width'?: number;
}

const { name, label, filled = false, ...rest } = Astro.props;
const brand = name in brandIcons && name !== 'podchaser';
const Svg = (brandIcons as Record<string, any>)[name] ?? (interfaceIcons as Record<string, any>)[name];
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
const fill = brand || filled ? { fill: 'currentColor' } : {};
---

<Svg width="24" height="24" focusable="false" {...fill} {...rest} {...a11y} data-icon={name} />
