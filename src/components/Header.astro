---
// Site header Component: logo, main navigation with one disclosure menu per
// section, the Qatar link and "Let’s Talk". One nav serves every width: below
// lg it collapses behind a Menu button.
//
// `idPrefix` keeps ids unique when the header is shown twice on a page (the
// style-guide page).
//
// The live site also has a search button; site search arrives with #13.
//
// The Menu button, the Qatar link and "Let’s Talk" are Fulldev Buttons. The
// menus stay our own disclosures rather than Fulldev's Navigation Menu, which
// opens on hover and animates one shared panel, and covers wide screens only
// (ADR-0005).
import { Button } from '@/components/ui/button';
import { brandButton, focusOutline } from './button';
import Logo from '../design-system/Logo.astro';
import Icon from './Icon.astro';
import { mainNav, contactLink, qatarLink } from '../data/site';

interface Props {
  idPrefix?: string;
  // Lies over the top of a full-height hero, translucent, as on the live
  // homepage.
  overlay?: boolean;
}

const { idPrefix = 'site', overlay = false } = Astro.props;
const menuId = `${idPrefix}-menu`;

// The header's controls change colour at once on hover, with no transition.
const plain = [brandButton, focusOutline, 'text-sm transition-none focus-visible:outline-inverse'];
---

<header
  class:list={['z-20 text-inverse', overlay ? 'absolute inset-x-0 top-0 bg-header-overlay backdrop-blur-md' : 'relative bg-band-dark']}
  data-header
>
  <div class="mx-auto flex min-h-18 max-w-7xl items-center justify-between gap-4 px-5 sm:px-6 lg:min-h-25">
    <a href="/" aria-label="Chesamel home" class="-ml-2 shrink-0 rounded-md focus-visible:outline-2 focus-visible:outline-inverse">
      <Logo variant="lockup" tone="on-dark" height={32} />
    </a>

    <Button
      class:list={[...plain, 'gap-2 rounded-md border-0 bg-control-on-dark px-4 py-2.5 text-inverse hover:bg-control-on-dark-hover lg:hidden']}
      aria-expanded="false"
      aria-controls={menuId}
      data-menu-toggle
    >
      <Icon name="menu" class="size-4" stroke-width={3} />
      Menu
    </Button>

    <div
      id={menuId}
      class="absolute inset-x-0 top-full hidden max-h-[calc(100vh-5rem)] overflow-y-auto bg-band-dark px-5 pb-6 sm:px-6 lg:static lg:flex lg:max-h-none lg:flex-1 lg:items-center lg:justify-between lg:overflow-visible lg:p-0"
      data-menu
    >
      <nav aria-label="Main" class="lg:mx-auto">
        <ul class="flex flex-col lg:flex-row lg:gap-2">
          {
            mainNav.map((section, i) => {
              const panelId = `${idPrefix}-nav-${i}`;
              return (
                <li class="relative border-b border-rule-on-dark lg:border-0">
                  <button
                    type="button"
                    class="group flex w-full items-center justify-between gap-1 py-4 text-base font-semibold lg:w-auto lg:px-3 lg:text-sm xl:text-base"
                    aria-expanded="false"
                    aria-controls={panelId}
                    data-nav-toggle
                  >
                    <span class="underline decoration-transparent decoration-2 underline-offset-8 transition-colors duration-300 group-hover:decoration-current group-focus-visible:decoration-current group-aria-expanded:decoration-current">{section.label}</span>
                    <Icon name="triangle" class="size-2.5 rotate-180 transition-transform duration-300 group-aria-expanded:rotate-0" />
                  </button>
                  <ul
                    id={panelId}
                    hidden
                    class="pb-4 lg:absolute lg:left-0 lg:top-full lg:min-w-64 lg:rounded-lg lg:bg-panel lg:p-3 lg:shadow-xl"
                  >
                    {section.links.map((link) => (
                      <li>
                        <a
                          href={link.href}
                          class="block rounded-md px-3 py-2 text-base text-body-on-dark transition-[background-color,padding] duration-300 hover:bg-control-on-dark hover:ps-4 focus-visible:bg-control-on-dark focus-visible:ps-4 lg:text-sm lg:text-body lg:hover:bg-surface lg:focus-visible:bg-surface"
                        >
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              );
            })
          }
        </ul>
      </nav>

      <div class="mt-6 flex items-center gap-3 lg:mt-0">
        <Button
          as="a"
          href={qatarLink.href}
          hreflang="ar"
          class:list={[...plain, 'gap-2 rounded-md border-0 bg-control-on-dark px-4 py-2.5 text-inverse hover:bg-control-on-dark-hover focus-visible:bg-control-on-dark-hover']}
        >
          {qatarLink.label}
          <span aria-hidden="true">↗</span>
        </Button>
        <Button
          as="a"
          href={contactLink.href}
          class:list={[...plain, 'block rounded-md border-0 bg-primary px-4 py-2.5 text-inverse hover:bg-panel hover:text-heading focus-visible:bg-panel focus-visible:text-heading']}
        >
          {contactLink.label}
        </Button>
      </div>
    </div>
  </div>
</header>

<script>
  // Disclosure menus: a button toggles the panel named by aria-controls.
  // Opening one section closes the others. Escape or a click outside closes
  // them all.
  for (const header of document.querySelectorAll<HTMLElement>('[data-header]')) {
    const menuToggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
    const menu = header.querySelector<HTMLElement>('[data-menu]')!;
    const navToggles = [...header.querySelectorAll<HTMLButtonElement>('[data-nav-toggle]')];

    const setOpen = (button: HTMLButtonElement, open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      document.getElementById(button.getAttribute('aria-controls')!)!.hidden = !open;
    };

    const closeSections = (except?: HTMLButtonElement) => {
      for (const b of navToggles) if (b !== except) setOpen(b, false);
    };

    menuToggle.addEventListener('click', () => {
      const open = menuToggle.getAttribute('aria-expanded') !== 'true';
      menuToggle.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('hidden', !open);
      if (!open) closeSections();
    });

    for (const button of navToggles) {
      button.addEventListener('click', () => {
        closeSections(button);
        setOpen(button, button.getAttribute('aria-expanded') !== 'true');
      });
    }

    header.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      const open = navToggles.find((b) => b.getAttribute('aria-expanded') === 'true');
      if (open) {
        setOpen(open, false);
        open.focus();
      }
    });

    document.addEventListener('click', (event) => {
      if (!header.contains(event.target as Node)) closeSections();
    });
  }
</script>
