---
// The filters, count and browser-side filtering shared by the Blog Post and
// Case Study listings. The listing passes its items as `<li>`s in the slot,
// each with `data-pillars` and `data-industries` (space-separated slugs).
//
// Every item is in the HTML, so the page works (unfiltered) without
// JavaScript; the script shows the filters, hides what doesn't match, and
// keeps the chosen filters in the address (?pillar=…&industry=…) so a
// filtered view can be shared. An item with no Industry is shown while no
// Industry is chosen and hidden once one is.
//
// Each filter is a Fulldev Toggle Group (ADR-0005): Data Slot keeps one button
// pressed, sets aria-pressed and moves between the buttons with the arrow keys.
import { ToggleGroup, ToggleGroupItem } from '@/components/ui/toggle-group';
import { pillarLabels, industryLabels } from '../data/taxonomy';

interface Props {
  // Each filter shown, with its visible label ("Pillar", "Service", "Industry").
  filters: { key: 'pillar' | 'industry'; label: string }[];
  total: number;
  // The count's noun, singular and plural: ['Case Study', 'Case Studies'].
  noun: [string, string];
  tone?: 'light' | 'dark';
}

const { filters, total, noun, tone = 'light' } = Astro.props;
const options = { pillar: Object.entries(pillarLabels), industry: Object.entries(industryLabels) };
const dark = tone === 'dark';

// The brand's square outlined filter button, filled Indigo when pressed, in
// place of Fulldev's rounded grey toggle.
const button = [
  'h-auto min-w-0 cursor-pointer whitespace-normal border px-4 py-2 font-semibold transition-none hover:bg-transparent',
  'data-[state=on]:border-indigo data-[state=on]:bg-indigo data-[state=on]:text-white data-[state=on]:hover:border-indigo data-[state=on]:hover:text-white',
  dark ? 'border-dark-grey text-off-white hover:border-white hover:text-white' : 'border-medium-grey text-dark-grey hover:border-indigo hover:text-indigo',
];
---

<div data-filtered-listing data-noun-one={noun[0]} data-noun-many={noun[1]}>
  <div data-filters hidden class="flex flex-col gap-5">
    {
      filters.map((g) => (
        <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline">
          <p class:list={['type-tag w-24 shrink-0', dark && 'text-off-white']} aria-hidden="true">
            {g.label}
          </p>
          <ToggleGroup aria-label={g.label} defaultValue="all" data-filter={g.key} class="w-auto flex-wrap rounded-none">
            <ToggleGroupItem value="all" class:list={button}>
              All
            </ToggleGroupItem>
            {options[g.key].map(([value, label]) => (
              <ToggleGroupItem value={value} class:list={button}>
                {label}
              </ToggleGroupItem>
            ))}
          </ToggleGroup>
        </div>
      ))
    }
  </div>
  <p role="status" class:list={['type-caption mt-8', dark && 'text-off-white']} data-count>
    {`${total} ${total === 1 ? noun[0] : noun[1]}`}
  </p>
  <slot />
</div>

<script>
  import { createToggleGroup } from '@data-slot/toggle-group';

  for (const listing of document.querySelectorAll<HTMLElement>('[data-filtered-listing]')) {
    const filters = listing.querySelector<HTMLElement>('[data-filters]')!;
    const count = listing.querySelector<HTMLElement>('[data-count]')!;
    const items = [...listing.querySelectorAll<HTMLLIElement>('li[data-pillars]')];
    const { nounOne, nounMany } = listing.dataset;
    const params = new URLSearchParams(location.search);
    // Each filter's controller; Data Slot hands back the one it already made.
    const groups = [...filters.querySelectorAll<HTMLElement>('[data-filter]')].map((root) => ({
      key: root.dataset.filter!,
      root,
      control: createToggleGroup(root),
    }));
    // The chosen value of a filter, or '' for All.
    const chosen = (key: string) => {
      const value = groups.find((g) => g.key === key)?.control.value[0];
      return value && value !== 'all' ? value : '';
    };

    function apply() {
      let shown = 0;
      const pillar = chosen('pillar');
      const industry = chosen('industry');
      for (const item of items) {
        const pillars = item.dataset.pillars!.split(' ');
        const industries = item.dataset.industries!.split(' ').filter(Boolean);
        const visible = (!pillar || pillars.includes(pillar)) && (!industry || industries.includes(industry));
        item.hidden = !visible;
        if (visible) shown++;
      }
      count.textContent = `${shown} ${shown === 1 ? nounOne : nounMany}`;
    }

    for (const { key, root, control } of groups) {
      const initial = params.get(key);
      if (initial) control.setValue(initial);
      if (control.value.length === 0) control.setValue('all');

      root.addEventListener('toggle-group:change', () => {
        // Pressing the chosen button again would leave none pressed: keep All.
        if (control.value.length === 0) control.setValue('all');
        const url = new URL(location.href);
        for (const g of groups) {
          if (chosen(g.key)) url.searchParams.set(g.key, chosen(g.key));
          else url.searchParams.delete(g.key);
        }
        history.replaceState(null, '', url);
        apply();
      });
    }

    filters.hidden = false;
    apply();
  }
</script>
