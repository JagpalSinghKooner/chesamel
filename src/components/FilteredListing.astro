---
// The filters, count and browser-side filtering shared by the Blog Post and
// Case Study listings. The listing passes its items as `<li>`s in the slot,
// each with `data-pillars` and `data-industries` (space-separated slugs).
//
// Every item is in the HTML, so the page works (unfiltered) without
// JavaScript; the script shows the filters, hides what doesn't match, and
// keeps the chosen filters in the address (?pillar=…&industry=…) so a
// filtered view can be shared. An item with no Industry is shown while no
// Industry is chosen and hidden once one is.
import { pillarLabels, industryLabels } from '../data/taxonomy';


interface Props {
  // Each filter shown, with its visible label ("Pillar", "Service", "Industry").
  filters: { key: 'pillar' | 'industry'; label: string }[];
  total: number;
  // The count's noun, singular and plural: ['Case Study', 'Case Studies'].
  noun: [string, string];
  tone?: 'light' | 'dark';
}

const { filters, total, noun, tone = 'light' } = Astro.props;
const options = { pillar: Object.entries(pillarLabels), industry: Object.entries(industryLabels) };
const dark = tone === 'dark';
---

<div data-filtered-listing data-noun-one={noun[0]} data-noun-many={noun[1]} class:list={[dark && 'listing-dark']}>
  <div data-filters hidden class="flex flex-col gap-5">
    {
      filters.map((g) => (
        <div role="group" aria-label={g.label} data-filter={g.key} class="flex flex-col gap-2 sm:flex-row sm:items-baseline">
          <p class:list={['type-tag w-24 shrink-0', dark && 'text-off-white']} aria-hidden="true">
            {g.label}
          </p>
          <ul class="flex flex-wrap gap-2">
            <li>
              <button type="button" data-value="" aria-pressed="true" class="filter-button">
                All
              </button>
            </li>
            {options[g.key].map(([value, label]) => (
              <li>
                <button type="button" data-value={value} aria-pressed="false" class="filter-button">
                  {label}
                </button>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <p role="status" class:list={['type-caption mt-8', dark && 'text-off-white']} data-count>
    {`${total} ${total === 1 ? noun[0] : noun[1]}`}
  </p>
  <slot />
</div>

<style>
  @reference "../styles/global.css";

  .filter-button {
    @apply cursor-pointer border border-medium-grey px-4 py-2 text-sm font-semibold text-dark-grey hover:border-indigo hover:text-indigo;
  }
  .filter-button[aria-pressed='true'] {
    @apply border-indigo bg-indigo text-white hover:text-white;
  }
  .listing-dark .filter-button {
    @apply border-dark-grey text-off-white hover:border-white hover:text-white;
  }
  .listing-dark .filter-button[aria-pressed='true'] {
    @apply border-indigo bg-indigo text-white;
  }
</style>

<script>
  for (const listing of document.querySelectorAll<HTMLElement>('[data-filtered-listing]')) {
    const filters = listing.querySelector<HTMLElement>('[data-filters]')!;
    const count = listing.querySelector<HTMLElement>('[data-count]')!;
    const items = [...listing.querySelectorAll<HTMLLIElement>('li[data-pillars]')];
    const groups = [...filters.querySelectorAll<HTMLElement>('[data-filter]')];
    const { nounOne, nounMany } = listing.dataset;
    const params = new URLSearchParams(location.search);
    const chosen: Record<string, string> = {};

    function apply() {
      let shown = 0;
      for (const item of items) {
        const pillars = item.dataset.pillars!.split(' ');
        const industries = item.dataset.industries!.split(' ').filter(Boolean);
        const visible =
          (!chosen.pillar || pillars.includes(chosen.pillar)) && (!chosen.industry || industries.includes(chosen.industry));
        item.hidden = !visible;
        if (visible) shown++;
      }
      count.textContent = `${shown} ${shown === 1 ? nounOne : nounMany}`;
      for (const group of groups) {
        for (const b of group.querySelectorAll<HTMLButtonElement>('button')) {
          b.setAttribute('aria-pressed', String(b.dataset.value === (chosen[group.dataset.filter!] ?? '')));
        }
      }
    }

    for (const group of groups) {
      const key = group.dataset.filter!;
      const values = [...group.querySelectorAll<HTMLButtonElement>('button')].map((b) => b.dataset.value);
      const initial = params.get(key);
      if (initial && values.includes(initial)) chosen[key] = initial;

      group.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement).closest('button');
        if (!button) return;
        if (button.dataset.value) chosen[key] = button.dataset.value;
        else delete chosen[key];
        const url = new URL(location.href);
        for (const g of groups) {
          const k = g.dataset.filter!;
          if (chosen[k]) url.searchParams.set(k, chosen[k]);
          else url.searchParams.delete(k);
        }
        history.replaceState(null, '', url);
        apply();
      });
    }

    filters.hidden = false;
    apply();
  }
</script>
