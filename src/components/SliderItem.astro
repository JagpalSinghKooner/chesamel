---
// One slide of a Slider. Its width sets how many slides show at once: pass
// basis classes such as "md:basis-1/2 lg:basis-1/3"; one at a time by default.
import { CarouselItem } from '@/components/ui/carousel';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<CarouselItem class:list={['group-data-[orientation=horizontal]/carousel:ps-6', className]} data-slide>
  <slot />
</CarouselItem>
