---
// Careers job card, as on the live Careers page (#42): the brandmark and the
// role's location, the employer, the title, the role's facts as chips, an
// "Apply Now" button and the day it was posted. The whole card is one link
// to the role's page; "Apply Now" is part of it, not a second link.
//
// On hover or keyboard focus the card turns Indigo with white text and the
// button turns white, as on live (white on Indigo passes WCAG AA). Live's
// chips turn translucent white there, which leaves white text at about
// 3.8:1, so here they keep the Indigo and gain a white outline instead.
// Live's faint dot pattern behind a hovered card is left out.
import Icon from './Icon.astro';
import Logo from '../design-system/Logo.astro';
import { focusOutline } from './button';
import { formatShortDate, isoDate } from '../content/shared';

interface Props {
  href: string;
  title: string;
  // hero.details: [office_based, employment_type, location], as imported.
  details: string[];
  employer?: string;
  posted?: Date;
  headingLevel?: 'h3' | 'h4';
}

const { href, title, details, employer, posted, headingLevel: Heading = 'h3' } = Astro.props;
const [officeBased, employmentType, location] = details;
const chips = [officeBased, employmentType].filter(Boolean);
const hovered = 'group-hover:text-inverse group-focus-visible:text-inverse';
---

<a
  href={href}
  class:list={[
    focusOutline,
    'group flex h-full flex-col gap-7 border border-card-border p-7.5 text-body transition-colors duration-300 hover:bg-primary hover:text-inverse focus-visible:bg-primary focus-visible:text-inverse focus-visible:outline-focus',
  ]}
  data-component="career-card"
>
  <div class="flex items-center justify-between gap-7.5">
    {/* The logo carries its clear space as padding; the margin lines the mark up with the edge, as on live. */}
    <span class="-m-2.5 group-hover:*:text-inverse group-focus-visible:*:text-inverse"><Logo variant="brandmark" tone="on-light" height={46} /></span>
    {
      location && (
        <p class="flex items-center gap-2 text-base leading-none font-medium">
          <Icon name="map-pin" class:list={['size-5 shrink-0 text-emphasis', hovered]} />
          {location}
        </p>
      )
    }
  </div>
  <div>
    {employer && <p class="mb-2 text-base leading-none font-medium">{employer}</p>}
    <Heading class:list={['mb-5 text-2xl leading-8 font-semibold text-emphasis', hovered]}>{title}</Heading>
    {
      chips.length > 0 && (
        <ul class="flex flex-wrap gap-3">
          {chips.map((chip) => (
            <li class="border border-transparent bg-chip px-5.5 py-4 text-base leading-none font-semibold group-hover:border-chip-border-hover group-focus-visible:border-chip-border-hover">{chip}</li>
          ))}
        </ul>
      )
    }
  </div>
  <div class="mt-auto flex items-center gap-7">
    <span class="flex items-center gap-4 bg-primary px-5.5 py-4 text-base leading-none font-semibold text-inverse transition-colors duration-300 group-hover:bg-panel group-hover:text-body group-focus-visible:bg-panel group-focus-visible:text-body">
      Apply Now
      <Icon name="arrow-up-right" class="size-4 text-detail group-hover:text-emphasis group-focus-visible:text-emphasis rtl:-scale-x-100" />
    </span>
    {
      posted && (
        <p class="text-base font-medium leading-none">
          Posted:
          <time datetime={isoDate(posted)} class:list={['mt-1 block leading-6 font-semibold text-emphasis', hovered]}>
            {formatShortDate(posted)}
          </time>
        </p>
      )
    }
  </div>
</a>
