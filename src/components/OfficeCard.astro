---
// One Office card of the Office list. `lead` is the wide head-office card.
import { Card, CardContent } from '@/components/ui/card';
import { brandCard, brandCardContent } from './card';
import type { Office } from '../content/pages';

interface Props {
  office: Office;
  lead?: boolean;
  headingLevel?: 'h2' | 'h3';
}
const { office, lead = false, headingLevel: Heading = 'h3' } = Astro.props;
const tel = (phone: string) => `tel:${phone.replace(/[^+\d]/g, '')}`;
---

<Card class:list={[brandCard, 'h-full border border-light-grey bg-white', lead && 'lg:flex-row']} data-office={office.data.country}>
  {office.data.image && (
    <img src={office.data.image.src} alt={office.data.image.alt} loading="lazy" class:list={['aspect-[21/10] w-full object-cover', lead && 'lg:w-1/2']} />
  )}
  <CardContent class:list={[brandCardContent, 'flex-1 gap-3 p-6']}>
    <Heading class="type-heading-3 text-xl">{office.data.name}</Heading>
    {office.body?.trim() && <p>{office.body.trim()}</p>}
    <address class="not-italic">
      {office.data.address.map((line) => (
        <span class="block">{line}</span>
      ))}
    </address>
    {office.data.phone && (
      <p>
        <a href={tel(office.data.phone)} class="underline underline-offset-4">
          {office.data.phone}
        </a>
      </p>
    )}
    {office.data.directions && (
      <p>
        <a href={office.data.directions} rel="noopener" target="_blank" class="font-subheading underline underline-offset-4">
          Get Directions<span class="sr-only"> to {office.data.name} (opens in a new tab)</span>
        </a>
      </p>
    )}
  </CardContent>
</Card>
