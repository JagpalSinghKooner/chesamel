---
// Industry card: image, name and one-line summary, linking to the Industry
// page, as on the live Industries and Our Work pages. Built on Fulldev's Card
// (ADR-0005).
import { Card, CardContent } from '@/components/ui/card';
import { focusOutline } from './button';
import { brandCard, brandCardContent } from './card';
import { industryAddress, type Industry } from '../content/case-studies';

interface Props {
  industry: Industry;
  headingLevel?: 'h2' | 'h3' | 'h4';
  tone?: 'light' | 'dark';
}

const { industry, headingLevel: Heading = 'h3', tone = 'light' } = Astro.props;
const { title, card } = industry.data;
const dark = tone === 'dark';
---

<Card
  as="a"
  href={industryAddress(industry)}
  class:list={[brandCard, focusOutline, 'group h-full border transition-colors duration-300 focus-visible:outline-focus', dark ? 'border-border-on-dark hover:border-inverse focus-visible:outline-inverse' : 'border-border bg-panel hover:border-primary']}
  data-component="industry-card"
>
  <div class="aspect-[4/3] overflow-hidden">
    <img src={card.image.src} alt={card.image.alt} loading="lazy" class="size-full object-cover transition-transform duration-500 group-hover:scale-105 group-focus-visible:scale-105" />
  </div>
  <CardContent class:list={[brandCardContent, 'block p-5']}>
    <Heading class:list={['type-heading-3 text-xl group-hover:underline group-focus-visible:underline', dark && 'text-inverse']}>{title}</Heading>
    <p class:list={['mt-3', dark ? 'text-body-on-dark' : 'text-body']}>{card.summary}</p>
  </CardContent>
</Card>
