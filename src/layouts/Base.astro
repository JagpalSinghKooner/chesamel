---
import '../styles/global.css';
import { isNoindex } from '../noindex.mjs';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { CLOUDFLARE_WEB_ANALYTICS_TOKEN } from 'astro:env/server';
import { cloudflareBeacon } from '../lib/consent';

interface Props {
  title: string;
  description?: string;
  // The header lies over a full-height hero (the homepage).
  overlayHeader?: boolean;
}

const { title, description, overlayHeader = false } = Astro.props;
const noindex = isNoindex(Astro.url.pathname);
// Cookieless, so it runs for every visitor without consent (#12).
const beacon = cloudflareBeacon(CLOUDFLARE_WEB_ANALYTICS_TOKEN);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {beacon && <script is:inline defer {...beacon}></script>}
    <script is:inline>
      // Set before first paint so revealed Sections never flash. Visitors who
      // ask for less motion, or have no JavaScript, see everything still.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
    </script>
  </head>
  <body class="bg-white">
    <a
      href="#main"
      class="sr-only z-50 rounded-md bg-white px-4 py-2 font-semibold text-black focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
      >Skip to content</a
    >
    <CookieBanner />
    <Header overlay={overlayHeader} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Marks elements as they come into view: every Section after the first fades
      // in (global.css), and the brandmark rings turn once (BrandmarkRings).
      // Inline, so it runs with the page and never leaves Sections hidden waiting
      // for a bundle.
      {
      for (const section of document.querySelectorAll('main > :not(:first-child)')) section.dataset.reveal = '';
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.dataset.inView = '';
            observer.unobserve(entry.target);
          }
        },
        { rootMargin: '0px 0px -10% 0px' },
      );
      for (const element of document.querySelectorAll('[data-motion], [data-reveal]')) observer.observe(element);
      }
    </script>
  </body>
</html>

