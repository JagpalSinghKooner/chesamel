---
// The layout every Page, Pillar and Service shares: hero, breadcrumb, then
// its Sections, with its Markdown body among them.
import { render } from 'astro:content';
import Base from './Base.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Sections from '../components/Sections.astro';
import Form from '../components/Form.astro';
import type { Page, Pillar, Service } from '../content/pages';

interface Props {
  entry: Page | Pillar | Service;
  trail: { label: string; href?: string }[];
  // The <title>; the page's title with " | Chesamel" when not given.
  documentTitle?: string;
}
const { entry, trail, documentTitle } = Astro.props;
const { title, description, hero, sections } = entry.data;
const { Content } = await render(entry);
const hasBody = (entry.body ?? '').trim().length > 0;
// As on the live site: Pillars, Services, Contact and open roles have a light
// hero, every other Page an Indigo one.
const lightHero = entry.collection !== 'pages' || entry.id === 'contact' || entry.id.startsWith('careers/');
---

<Base title={documentTitle ?? `${title} | Chesamel`} description={description ?? hero.paragraphs[0] ?? hero.subtitle}>
  <PageHero {...hero} tone={lightHero ? 'light' : 'indigo'} faintRings={entry.id === 'contact'}>
    {entry.id === 'contact' && <Form slot="aside" kind="contact" />}
  </PageHero>
  <Breadcrumb band trail={[...trail, { label: title }]} />
  <Sections sections={sections} hasBody={hasBody}><Content /></Sections>
</Base>
