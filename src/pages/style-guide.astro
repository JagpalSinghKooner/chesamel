---
// Private style-guide page: every Design System token, for designers to point
// at. Hidden from search engines and the sitemap through src/noindex.mjs.
import Base from '../layouts/Base.astro';
import { colourGroups } from '../design-system/colours';
import { pillars } from '../data/pillars';
import Logo from '../design-system/Logo.astro';
import Icon from '../components/Icon.astro';
import { brandIcons, interfaceIcons, type IconName } from '../design-system/icons';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import ClientLogos from '../components/home/ClientLogos.astro';
import PillarCards from '../components/PillarCards.astro';
import CtaBlock from '../components/CtaBlock.astro';
import Form from '../components/Form.astro';
import ConnectWithUs from '../components/home/ConnectWithUs.astro';
import BlogPostCard from '../components/BlogPostCard.astro';
import BlogPostListing from '../components/BlogPostListing.astro';
import { getBlogPosts, summarisePost } from '../content/blog';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import CaseStudySlider from '../components/CaseStudySlider.astro';
import CaseStudyListing from '../components/CaseStudyListing.astro';
import IndustryCard from '../components/IndustryCard.astro';
import { getCaseStudies, getIndustries, summariseCaseStudy } from '../content/case-studies';
import PageHero from '../components/PageHero.astro';
import InsightsHero from '../components/InsightsHero.astro';
import BrandmarkRings from '../components/BrandmarkRings.astro';
import Slider from '../components/Slider.astro';
import SliderItem from '../components/SliderItem.astro';
import OfficeList from '../components/OfficeList.astro';
import TeamCard from '../components/sections/TeamCard.astro';
import Sections from '../components/Sections.astro';
import { getTeamMembers } from '../content/pages';
import { Accordion, AccordionContent, AccordionItem, AccordionTrigger } from '@/components/ui/accordion';
import { Breadcrumb, BreadcrumbItem, BreadcrumbLink, BreadcrumbList, BreadcrumbPage, BreadcrumbSeparator } from '@/components/ui/breadcrumb';
import { Button } from '@/components/ui/button';
import { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from '@/components/ui/card';
import { Carousel, CarouselContent, CarouselItem, CarouselNext, CarouselPrevious } from '@/components/ui/carousel';
import {
  NavigationMenu,
  NavigationMenuContent,
  NavigationMenuItem,
  NavigationMenuLink,
  NavigationMenuList,
  NavigationMenuTrigger,
} from '@/components/ui/navigation-menu';
import { Sheet, SheetContent, SheetDescription, SheetHeader, SheetTitle, SheetTrigger } from '@/components/ui/sheet';
import { Tabs, TabsContent, TabsList, TabsTrigger } from '@/components/ui/tabs';
import { ToggleGroup, ToggleGroupItem } from '@/components/ui/toggle-group';

const newestPosts = (await getBlogPosts()).slice(0, 6).map(summarisePost);
const newestCaseStudies = (await getCaseStudies()).slice(0, 4).map(summariseCaseStudy);
const [sampleIndustry] = await getIndustries();

// Each logo in each colour the guidelines permit, on a background that suits
// it. The dashed outline shows the clear space built into the Component.
const logoExamples = [
  { variant: 'wordmark', title: 'Wordmark', note: 'Clear space: the height of its “c”.' },
  { variant: 'lockup', title: 'Lockup', note: 'Clear space: the width of “ch”. Used in the header.' },
  { variant: 'tagline-lockup', title: 'Logo with tagline', note: 'Clear space: the width of “ch”. Used in the footer.' },
] as const;

const typeStyles = [
  { cls: 'type-heading-1', spec: 'Heading 1: Figtree Medium, 56px, leading 100%, Black', sample: 'Believe it’s possible' },
  { cls: 'type-heading-2', spec: 'Heading 2: Figtree Medium, 40px, leading 100%, Black', sample: 'Believe it’s possible' },
  { cls: 'type-heading-3', spec: 'Heading 3: Figtree Medium, 28px, leading 100%, Black', sample: 'Believe it’s possible' },
  { cls: 'type-subheading', spec: 'Subheading: DM Sans Regular, 20px, leading 145%, Indigo', sample: 'An agile collective of experts driving extraordinary growth.' },
  { cls: 'type-body', spec: 'Body: Figtree Regular, 16px, leading 145%, Dark Grey', sample: 'We create innovative, bespoke solutions that fuel positive change. Together we challenge accepted ways of thinking to deliver transformative business outcomes.' },
  { cls: 'type-tag', spec: 'Tag: Figtree SemiBold, 14px, tracking 0.04em, uppercase, Dark Grey', sample: 'Digital Transformation' },
  { cls: 'type-caption', spec: 'Caption: Figtree Regular, 14px, Dark Grey', sample: 'Photo: the Chesamel team in London.' },
  { cls: 'type-large-grey', spec: 'Large grey: Figtree Regular, 24px, Grey. Grey only at this size or larger.', sample: 'Be compassionate. Be brave. Be brilliant.' },
];
---

<Base title="Style guide | Chesamel">
  <div class="mx-auto max-w-5xl px-6 py-16">
    <h1 class="type-heading-1">Style guide</h1>
    <p class="type-subheading mt-4">Every colour and type style in the Chesamel Design System.</p>

    <section aria-labelledby="colours" class="mt-16">
      <h2 id="colours" class="type-heading-2">Colours</h2>
      {
        colourGroups.map((group) => (
          <div class="mt-10">
            <h3 class="type-heading-3">{group.title}</h3>
            <p class="type-body mt-3 max-w-2xl">{group.usage}</p>
            <ul class="mt-6 grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-5">
              {group.colours.map((c) => (
                <li data-colour={c.token} data-hex={c.hex}>
                  <div
                    data-swatch
                    aria-hidden="true"
                    class="h-24 rounded-lg border border-light-grey"
                    style={`background-color: var(--color-${c.token})`}
                  />
                  <p class="type-body mt-2 font-semibold text-black">{c.name}</p>
                  <p class="type-caption">{c.hex}</p>
                  <p class="type-caption">
                    <code>{c.token}</code>
                  </p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <div class="mt-10">
        <h3 class="type-heading-3">Pillar accents</h3>
        <p class="type-body mt-3 max-w-2xl">
          Each Pillar, and its Services, has one secondary colour (ADR-0002), from <code>accent</code> in
          <code>src/data/pillars.ts</code>. Only for small marks such as this bar, tag borders, dots and icons; the text
          stays Black.
        </p>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {pillars.map((p) => (
            <li data-pillar-accent={p.name} class="flex items-center gap-3 border border-light-grey p-4 font-semibold text-black">
              <span data-accent-bar aria-hidden="true" class="h-8 w-1" style={`background-color: var(--color-${p.accent})`} />
              {p.name}
              <code class="type-caption ms-auto font-normal">{p.accent}</code>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section aria-labelledby="logos" class="mt-20" data-style-guide="logos">
      <h2 id="logos" class="type-heading-2">Logo</h2>
      <p class="type-body mt-3 max-w-2xl">
        <code>Logo</code> Component. White on Indigo or Black, Black on white; the brandmark may also be Indigo on white.
        Clear space is built in, so never add your own margin to squeeze it.
      </p>
      {
        logoExamples.map((l) => (
          <div class="mt-10">
            <h3 class="type-heading-3">{l.title}</h3>
            <p class="type-caption mt-2">{l.note}</p>
            <div class="mt-4 flex flex-wrap gap-4">
              <div class="rounded-lg bg-black p-4"><span class="block outline-1 outline-dashed outline-medium-grey"><Logo variant={l.variant} colour="white" height={48} /></span></div>
              <div class="rounded-lg border border-light-grey bg-white p-4"><span class="block outline-1 outline-dashed outline-medium-grey"><Logo variant={l.variant} colour="black" height={48} /></span></div>
            </div>
          </div>
        ))
      }
      <div class="mt-10">
        <h3 class="type-heading-3">Brandmark</h3>
        <p class="type-caption mt-2">Clear space: the corner circles on page 9 of the guidelines, about a quarter of its height.</p>
        <div class="mt-4 flex flex-wrap gap-4">
          <div class="rounded-lg bg-indigo p-4"><span class="block outline-1 outline-dashed outline-white"><Logo variant="brandmark" colour="white" height={48} /></span></div>
          <div class="rounded-lg border border-light-grey bg-white p-4"><span class="block outline-1 outline-dashed outline-medium-grey"><Logo variant="brandmark" colour="black" height={48} /></span></div>
          <div class="rounded-lg border border-light-grey bg-white p-4"><span class="block outline-1 outline-dashed outline-medium-grey"><Logo variant="brandmark" colour="indigo" height={48} /></span></div>
        </div>
      </div>
    </section>

    <section aria-labelledby="icons" class="mt-20" data-style-guide="icons">
      <h2 id="icons" class="type-heading-2">Icons</h2>
      <p class="type-body mt-3 max-w-2xl">
        <code>Icon</code> Component, the only way to show an icon. Interface icons from Lucide, brand logos from Simple
        Icons. They take the text colour, and are hidden from screen readers unless given a <code>label</code>.
      </p>
      {
        [
          { title: 'Interface', names: Object.keys(interfaceIcons) },
          { title: 'Brands', names: Object.keys(brandIcons) },
        ].map((group) => (
          <div class="mt-10">
            <h3 class="type-heading-3">{group.title}</h3>
            <ul class="mt-4 grid grid-cols-3 gap-6 sm:grid-cols-4 lg:grid-cols-6">
              {group.names.map((name) => (
                <li class="flex flex-col items-center gap-2 border border-light-grey p-4 text-black">
                  <Icon name={name as IconName} class="size-6" />
                  <code class="type-caption">{name}</code>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <p class="type-caption mt-6 flex items-center gap-2">
        With a label, for an icon that carries meaning on its own:
        <Icon name="linkedin" label="LinkedIn" class="size-6 text-indigo" />
      </p>
    </section>

    <section aria-labelledby="typography" class="mt-20">
      <h2 id="typography" class="type-heading-2">Typography</h2>
      <p class="type-body mt-3 max-w-2xl">
        Figtree for headings and body, DM Sans for subheadings, IBM Plex Sans Arabic for Arabic. Helvetica, then Arial,
        when the brand fonts can't load. Body text is Dark Grey, not Grey (ADR-0002).
      </p>
      <ul class="mt-10 space-y-10">
        {
          typeStyles.map((t) => (
            <li data-type-style={t.cls}>
              <p class="type-caption">
                <code>{t.cls}</code>: {t.spec}
              </p>
              <p class:list={[t.cls, 'mt-2']}>{t.sample}</p>
            </li>
          ))
        }
        <li data-type-style="arabic">
          <p class="type-caption">Arabic: IBM Plex Sans Arabic, right to left</p>
          <p lang="ar" dir="rtl" class="type-body mt-2 text-xl">آمن بأن كل شيء ممكن</p>
        </li>
      </ul>
    </section>
  </div>

  <section aria-labelledby="components" class="mt-20" data-style-guide="components">
    <div class="mx-auto max-w-5xl px-6">
      <h2 id="components" class="type-heading-2">Components</h2>
      <p class="type-body mt-3 max-w-2xl">Shown full width, as they appear on the site.</p>
    </div>
    <h3 class="type-heading-3 mx-auto mt-12 mb-4 max-w-5xl px-6">Header</h3>
    <Header idPrefix="style-guide" />
    <h3 class="type-heading-3 mx-auto mt-12 mb-4 max-w-5xl px-6">Hero</h3>
    <Hero
      headingLevel="h2"
      before="Global"
      words={['Business', 'Digital', 'Marketing', 'Workforce']}
      after="Transformation"
      image={{ src: '/images/hero-poster-960.webp' }}
      actions={[
        { label: 'What We Do', href: '/what-we-do/', tone: 'dark' },
        { label: 'Our Work', href: '/insights/our-work/', tone: 'indigo' },
      ]}
    />
    <h3 class="type-heading-3 mx-auto mt-12 mb-4 max-w-5xl px-6">Pillar cards</h3>
    <PillarCards headingLevel="h3">
      <p class="type-body max-w-md">The slot beside the cards takes any introduction, such as “How we add value”.</p>
    </PillarCards>
    <h3 class="type-heading-3 mx-auto mt-12 mb-4 max-w-5xl px-6">Call to action</h3>
    <CtaBlock
      headingLevel="h3"
      heading="Want to transform your business?"
      text="Accelerate your business growth into a new age"
      actions={[
        { label: 'What We Do', href: '/what-we-do/', tone: 'indigo' },
        { label: 'Let’s Talk', href: '/contact/', tone: 'outline' },
      ]}
    />
    <h3 class="type-heading-3 mx-auto mt-12 mb-4 max-w-5xl px-6">Blog Post card</h3>
    <div class="mx-auto max-w-5xl px-6">
      <div class="max-w-sm"><BlogPostCard post={newestPosts[0]} headingLevel="h4" /></div>
    </div>
    <h3 class="type-heading-3 mx-auto mt-12 mb-4 max-w-5xl px-6">Blog Post listing</h3>
    <div class="mx-auto max-w-5xl px-6">
      <p class="type-body mb-6 max-w-2xl">Pillar and Industry filters over Blog Post cards, as on News. Shown here with the six newest posts.</p>
      <BlogPostListing posts={newestPosts} headingLevel="h4" />
    </div>
    <h3 class="type-heading-3 mx-auto mt-12 mb-4 max-w-5xl px-6">Case Study card</h3>
    <div class="mx-auto max-w-5xl px-6">
      <p class="type-body mb-6 max-w-2xl">Image, main Pillar, the client when known, and the title. Shown here with the newest Case Study.</p>
      <div class="max-w-md"><CaseStudyCard caseStudy={newestCaseStudies[0]} headingLevel="h4" /></div>
    </div>
    <h3 class="type-heading-3 mx-auto mt-12 mb-4 max-w-5xl px-6">Case Study slider</h3>
    <p class="type-body mx-auto mb-6 max-w-5xl px-6">
      Dark, as on Industry and Case Study pages, and light, as for “Latest Work” on Our Work. One card per view on
      phones, two from 768px.
    </p>
    <CaseStudySlider
      id="style-guide-slider-dark"
      headingLevel="h3"
      eyebrow="/ why not read more"
      heading="Our Related Case Studies"
      action={{ label: 'View All Case Studies', href: '/insights/our-work/' }}
      caseStudies={newestCaseStudies.slice(0, 3)}
    />
    <CaseStudySlider id="style-guide-slider-light" headingLevel="h3" tone="light" heading="Latest Work" caseStudies={newestCaseStudies.slice(0, 3)} />
    <h3 class="type-heading-3 mx-auto mt-12 mb-4 max-w-5xl px-6">Case Study listing</h3>
    <div class="mx-auto max-w-5xl px-6">
      <p class="type-body mb-6 max-w-2xl">Service and Industry filters over Case Study cards, as on Our Work; the Industries page shows the Industry filter only. Shown here with the four newest Case Studies.</p>
      <CaseStudyListing caseStudies={newestCaseStudies} headingLevel="h4" />
    </div>
    <h3 class="type-heading-3 mx-auto mt-12 mb-4 max-w-5xl px-6">Industry card</h3>
    <div class="mx-auto max-w-5xl px-6">
      <div class="max-w-xs"><IndustryCard industry={sampleIndustry} headingLevel="h4" /></div>
    </div>
    <h3 class="type-heading-3 mx-auto mt-12 mb-4 max-w-5xl px-6">Page hero</h3>
    <p class="type-body mx-auto mb-6 max-w-5xl px-6">Tops every Page, Pillar and Service.</p>
    <PageHero title="Who We Are" paragraphs={['The Indigo tone, on most Pages.']} links={[{ label: 'Our Team', href: '/who-we-are/our-team/' }]} headingLevel="h4" />
    <PageHero tone="light" title="Marketing Engine" paragraphs={['The light tone, on Pillars, Services, Contact and open roles.']} links={[{ label: "Let's Chat", href: '/contact/' }]} headingLevel="h4" />
    <h3 class="type-heading-3 mx-auto mt-12 mb-4 max-w-5xl px-6">Listing hero</h3>
    <p class="type-body mx-auto mb-6 max-w-5xl px-6">Tops the Insights hub, News, Our Work, Industries and the Podcast, Webinar and Report listings.</p>
    <InsightsHero heading="Insights" text="Check out our latest thoughts, business updates, and original content." breadcrumb={false} headingLevel="h4" />
    <h3 class="type-heading-3 mx-auto mt-12 mb-4 max-w-5xl px-6">Brandmark rings</h3>
    <p class="type-body mx-auto mb-6 max-w-5xl px-6">
      The animated brandmark behind heroes and calls to action. The rings turn once as they come into view, then rest;
      under reduced motion they stay still.
    </p>
    <div class="mx-auto grid max-w-5xl gap-4 px-6 sm:grid-cols-3">
      <div class="bg-white p-6 outline-1 outline-light-grey"><BrandmarkRings solid class="mx-auto size-40" /></div>
      <div class="bg-indigo p-6"><BrandmarkRings tone="white" class="mx-auto size-40" /></div>
      <div class="bg-black p-6"><BrandmarkRings tone="white" class="mx-auto size-40" /></div>
    </div>
    <h3 class="type-heading-3 mx-auto mt-12 mb-4 max-w-5xl px-6">Client logo strip</h3>
    <p class="type-body mx-auto mb-6 max-w-5xl px-6">Scrolls sideways with a pause button; still under reduced motion.</p>
    <ClientLogos />
    <h3 class="type-heading-3 mx-auto mt-12 mb-4 max-w-5xl px-6">Slider</h3>
    <p class="type-body mx-auto mb-6 max-w-5xl px-6">
      Moves by drag, the buttons, or the arrow keys, Home and End once focus is inside. Without JavaScript it scrolls sideways.
    </p>
    <div class="mx-auto max-w-5xl px-6">
      <Slider label="Sample slider">
        {['One', 'Two', 'Three', 'Four', 'Five'].map((n) => (
          <SliderItem class="sm:basis-1/2 lg:basis-1/3"><div class="flex h-40 items-center justify-center bg-off-white type-heading-3">{n}</div></SliderItem>
        ))}
      </Slider>
    </div>
    <h3 class="type-heading-3 mx-auto mt-12 mb-4 max-w-5xl px-6">Office list</h3>
    <div class="mx-auto max-w-5xl px-6"><OfficeList /></div>
    <h3 class="type-heading-3 mx-auto mt-12 mb-4 max-w-5xl px-6">Team Member card</h3>
    <div class="mx-auto max-w-5xl px-6"><div class="max-w-xs"><TeamCard member={(await getTeamMembers()).find((m) => m.id === 'john-cofie')!} headingLevel="h4" /></div></div>
    <h3 class="type-heading-3 mx-auto mt-12 mb-4 max-w-5xl px-6">Sections</h3>
    <p class="type-body mx-auto mb-6 max-w-5xl px-6">
      Pages, Pillars and Services are lists of Sections, each drawn by its own Component. Shown here: stats, cards,
      points, the shared delivery models, the Group Brands and tabs.
    </p>
    <Sections
      sections={[
        { type: 'stats', items: [{ value: '150+', label: '/ People' }, { value: '17+', label: '/ Operating Countries' }] },
        { type: 'cards', heading: 'Our Approach', tone: 'off-white', layout: 'grid', items: [{ heading: 'Planning', text: 'Gearing up for growth.' }, { heading: 'Teamwork', text: 'Finding the right collaborators.' }] },
        {
          type: 'cards',
          heading: 'Why Us (as a slider)',
          tone: 'dark',
          layout: 'slider',
          items: [
            { heading: 'Recognition', text: 'We recognise and reward our people.' },
            { heading: 'Support', text: 'Private healthcare and an assistance programme.' },
            { heading: 'Celebrate', text: 'Birthdays, anniversaries and cultural days.' },
            { heading: 'Balance', text: 'Three days in the office, two from home.' },
          ],
        },
        { type: 'points', heading: 'How we work', tone: 'dark', paragraphs: [], items: ['We help organisations find the right focus.', 'We connect research and strategy.'], note: 'Need clarity fast?' },
        { type: 'deliveryModels', heading: 'Our Delivery Models' },
        { type: 'brands', heading: 'Our Group Brands' },
        {
          type: 'tabs',
          heading: 'Providing expertise',
          paragraphs: [],
          items: [
            { title: 'Marketing Engine', paragraphs: ['Strategic marketing that drives measurable impact.'], list: ['Branding', 'Research & Data'] },
            { title: 'Hybrid Workforce', paragraphs: ['A hybrid workforce that builds stronger teams.'], list: ['Talent Hub'] },
          ],
        },
      ]}
    />
    <h3 class="type-heading-3 mx-auto mt-12 mb-4 max-w-5xl px-6">Contact form</h3>
    <p class="type-body mx-auto mb-6 max-w-5xl px-6">
      In the Contact hero. Each field is checked when it loses focus and again on submit; a valid submit shows the
      success message and sends nothing yet (#48 sends it to HubSpot). Shown empty, with errors, and sent.
    </p>
    <div class="mx-auto grid max-w-5xl gap-4 px-6 lg:grid-cols-2" data-style-guide="contact-form">
      <div class="bg-off-white p-6"><Form kind="contact" idPrefix="style-guide-contact" /></div>
      <div class="bg-off-white p-6"><Form kind="contact" idPrefix="style-guide-contact-errors" preview="errors" /></div>
      <div class="bg-off-white p-6"><Form kind="contact" idPrefix="style-guide-contact-success" preview="success" /></div>
    </div>
    <h3 class="type-heading-3 mx-auto mt-12 mb-4 max-w-5xl px-6">Newsletter form</h3>
    <p class="type-body mx-auto mb-6 max-w-5xl px-6">The newsletter band, then its form with errors, and sent.</p>
    <ConnectWithUs idPrefix="style-guide-newsletter" />
    <div class="mx-auto mt-4 grid max-w-5xl gap-4 px-6 lg:grid-cols-2" data-style-guide="newsletter-form">
      <div class="bg-indigo p-6"><Form kind="newsletter" idPrefix="style-guide-newsletter-errors" preview="errors" /></div>
      <div class="bg-indigo p-6"><Form kind="newsletter" idPrefix="style-guide-newsletter-success" preview="success" /></div>
    </div>
    <h3 class="type-heading-3 mx-auto mt-12 mb-4 max-w-5xl px-6">Footer</h3>
    <Footer />
  </section>

  <section aria-labelledby="building-blocks" class="mx-auto mt-20 max-w-5xl px-6 pb-20" data-style-guide="building-blocks">
    <h2 id="building-blocks" class="type-heading-2">Fulldev building blocks</h2>
    <p class="type-body mt-3 max-w-2xl">
      The Fulldev UI pieces the Components above are built from (ADR-0005), shown with Fulldev's own styling under the
      brand tokens: brand colours, square corners, no dark mode. The Components pass their own classes on top.
    </p>
    <div class="mt-10 grid gap-12">
      <div data-building-block="button">
        <h3 class="type-heading-3">Button</h3>
        <div class="mt-4 flex flex-wrap gap-3">
          <Button>Primary</Button>
          <Button variant="outline">Outline</Button>
          <Button variant="secondary">Secondary</Button>
          <Button variant="ghost">Ghost</Button>
          <Button variant="link">Link</Button>
        </div>
      </div>
      <div data-building-block="card">
        <h3 class="type-heading-3">Card</h3>
        <Card class="mt-4 max-w-sm">
          <CardHeader>
            <CardTitle as="h4">Card title</CardTitle>
            <CardDescription>A short description under the title.</CardDescription>
          </CardHeader>
          <CardContent>The card's content.</CardContent>
          <CardFooter><Button size="sm">Action</Button></CardFooter>
        </Card>
      </div>
      <div data-building-block="breadcrumb">
        <h3 class="type-heading-3">Breadcrumb</h3>
        <Breadcrumb aria-label="Example breadcrumb" class="mt-4">
          <BreadcrumbList>
            <BreadcrumbItem><BreadcrumbLink href="/">Home</BreadcrumbLink></BreadcrumbItem>
            <BreadcrumbSeparator />
            <BreadcrumbItem><BreadcrumbLink href="/insights/">Insights</BreadcrumbLink></BreadcrumbItem>
            <BreadcrumbSeparator />
            <BreadcrumbItem><BreadcrumbPage>Our Work</BreadcrumbPage></BreadcrumbItem>
          </BreadcrumbList>
        </Breadcrumb>
      </div>
      <div data-building-block="tabs">
        <h3 class="type-heading-3">Tabs</h3>
        <Tabs defaultValue="one" class="mt-4">
          <TabsList aria-label="Example tabs">
            <TabsTrigger value="one">First</TabsTrigger>
            <TabsTrigger value="two">Second</TabsTrigger>
          </TabsList>
