---
// Root-level content at its original address: Blog Posts at /<slug>/ (and
// /news/<slug>/ for posts of WordPress's former `news` type), and standard
// Pages at their file path, such as /who-we-are/network/. Astro allows one
// root rest route, so every collection served at the root is added here.
import BlogPostPage from '../components/BlogPostPage.astro';
import { getBlogPosts, addressOf, type BlogPost } from '../content/blog';
import SectionsPage from '../layouts/SectionsPage.astro';
import { getPages, pageAddress, type Page } from '../content/pages';

export async function getStaticPaths() {
  const posts = (await getBlogPosts()).map((post) => ({ params: { slug: addressOf(post).slice(1, -1) }, props: { post } }));
  const pages = (await getPages()).map((page) => ({ params: { slug: pageAddress(page).slice(1, -1) }, props: { page } }));
  return [...posts, ...pages];
}

// A Page's breadcrumb walks up its address: /who-we-are/our-team/ sits under Who We Are.
async function trailOf(page: Page) {
  const all = await getPages();
  const parts = page.id.split('/').slice(0, -1);
  return [
    { label: 'Home', href: '/' },
    ...parts.map((_, i) => {
      const id = parts.slice(0, i + 1).join('/');
      const parent = all.find((p) => p.id === id);
      return { label: parent?.data.title ?? id, href: `/${id}/` };
    }),
  ];
}

const { post, page } = Astro.props as { post?: BlogPost; page?: Page };
---

{page ? <SectionsPage entry={page} trail={await trailOf(page)} /> : <BlogPostPage post={post!} />}
