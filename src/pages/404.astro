---
// Cloudflare Pages serves the homepage with a 200 for every unknown address
// unless this page exists, which would hide every broken address from the
// URL parity check.
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Chesamel">
  <main class="mx-auto max-w-3xl px-6 py-24">
    <h1 class="text-4xl font-bold">Page not found</h1>
    <p class="mt-4">We couldn't find that page. <a class="underline" href="/">Go to the homepage</a>.</p>
  </main>
</Base>
