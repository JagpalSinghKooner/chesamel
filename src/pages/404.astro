---
// Cloudflare Pages serves the homepage with a 200 for every unknown address
// unless this page exists, which would hide every broken address from the
// URL parity check.
//
// Laid out as the live 404: a light hero with the brandmark rings and two ways
// back in.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';

const text = 'This page may have been moved or removed, apologies for any inconvenience caused. Get back on track with the links below.';
---

<Base seo={{ title: 'Page not found | Chesamel', description: text }}>
  <PageHero
    tone="light"
    title="We couldn’t find that page"
    paragraphs={[text]}
    links={[
      { label: 'Homepage', href: '/' },
      { label: 'Our Services', href: '/what-we-do/' },
    ]}
  />
</Base>
