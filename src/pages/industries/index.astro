---
// Industries: the five Industries, then every Case Study with an Industry
// filter, as on the live page. The live page shows the Industry cards in a
// slider; here they sit in a grid, so all five are visible at once.
import Base from '../../layouts/Base.astro';
import InsightsHero from '../../components/InsightsHero.astro';
import Button from '../../components/Button.astro';
import GetStartedCta from '../../components/GetStartedCta.astro';
import CaseStudyListing from '../../components/CaseStudyListing.astro';
import IndustryCard from '../../components/IndustryCard.astro';
import ClientLogos from '../../components/home/ClientLogos.astro';
import { getCaseStudies, getIndustries, summariseCaseStudy } from '../../content/case-studies';

const caseStudies = (await getCaseStudies()).map(summariseCaseStudy);
const industries = await getIndustries();
---

<Base
  title="Industries | Chesamel"
  description="Explore the range of industries we serve and how we approach business transformation in each sector."
>
  <InsightsHero
    heading="Industries"
    text="Explore the range of industries we serve and how we approach business transformation in each sector."
    parents={[{ label: 'Home', href: '/' }]}
  />
  <section aria-labelledby="our-expertise">
    <div class="mx-auto grid max-w-7xl gap-8 px-5 py-20 sm:px-6 lg:py-28 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="font-subheading">/ our expertise</p>
        <h2 id="our-expertise" class="type-heading-2 mt-3">Tailored solutions for your sector</h2>
      </div>
      <p>
        No growth strategy is one-size-fits-all. We make sure your solution is built for the industry you're in and its
        unique challenges.
      </p>
    </div>
  </section>
  <section aria-labelledby="key-industries" class="bg-off-white">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-6 lg:py-28">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div>
          <h2 id="key-industries" class="type-heading-2">Key industries</h2>
          <p class="mt-4">See the value we bring to each sector.</p>
        </div>
        <Button href="/contact/" tone="dark">Contact</Button>
      </div>
      <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
        {industries.map((industry) => <li><IndustryCard industry={industry} /></li>)}
      </ul>
    </div>
  </section>
  <section aria-labelledby="latest-work" class="bg-black">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-6 lg:py-28">
      <p class="font-subheading text-off-white">/ see our work in action</p>
      <h2 id="latest-work" class="type-heading-2 mt-3 mb-10 text-white">Latest work</h2>
      <CaseStudyListing caseStudies={caseStudies} filters={['industry']} tone="dark" />
    </div>
  </section>
  <ClientLogos />
  <GetStartedCta />
</Base>
