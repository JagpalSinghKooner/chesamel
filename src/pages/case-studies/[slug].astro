---
// Case Studies at their original addresses, /case-studies/<slug>/. The layout
// follows the live page: a light hero with the title, main Pillar and excerpt;
// the date, objective and services beside the story; then the client logos
// and "Our Related Case Studies". The card image isn't shown here, as on the
// live site.
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Button from '../../components/Button.astro';
import LabelLinks from '../../components/LabelLinks.astro';
import ClientLogos from '../../components/home/ClientLogos.astro';
import CaseStudySlider from '../../components/CaseStudySlider.astro';
import { getCaseStudies, related, summariseCaseStudy, type CaseStudy } from '../../content/case-studies';
import { formatDate, isoDate, primaryPillar } from '../../content/shared';
import { pillarLabels } from '../../data/taxonomy';

export async function getStaticPaths() {
  const all = await getCaseStudies();
  return all.map((caseStudy) => ({ params: { slug: caseStudy.id }, props: { caseStudy, all } }));
}

const { caseStudy, all } = Astro.props as { caseStudy: CaseStudy; all: CaseStudy[] };
const { title, date, excerpt, objective, pillars, industries, description } = caseStudy.data;
const { Content } = await render(caseStudy);
const OUR_WORK = '/insights/our-work/';
---

<Base title={`${title} | Chesamel`} description={description ?? excerpt}>
  <section class="bg-off-white" data-case-study-hero>
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6">
      <h1 class="type-heading-1 max-w-4xl text-4xl sm:text-5xl">{title}</h1>
      <p class="type-tag mt-6">/ {pillarLabels[primaryPillar(caseStudy.data)]}</p>
      <p class="type-subheading mt-4 max-w-3xl">{excerpt}</p>
    </div>
  </section>
  <Breadcrumb
    band
    trail={[{ label: 'Home', href: '/' }, { label: 'Insights', href: '/insights/' }, { label: 'Our Work', href: OUR_WORK }, { label: title }]}
  />
  <article class="mx-auto grid max-w-7xl gap-12 px-4 py-16 sm:px-6 lg:grid-cols-[1fr_2fr]">
    <div class="flex flex-col gap-10">
      <dl class="flex flex-col gap-8">
        <div>
          <dt class="type-tag">/ date</dt>
          <dd class="mt-2"><time datetime={isoDate(date)}>{formatDate(date)}</time></dd>
        </div>
        <div>
          <dt class="type-tag">/ objective</dt>
          <dd class="mt-2 text-black">{objective}</dd>
        </div>
      </dl>
      <LabelLinks pillars={pillars} industries={industries} placement="column" />
    </div>
    <div>
      <div class="blog-body" data-case-study-body>
        <Content />
      </div>
      <div class="mt-16 flex flex-wrap gap-3 border-t border-light-grey pt-8">
        <Button href={OUR_WORK} tone="dark">Back to Case Studies</Button>
        <Button href="/what-we-do/" tone="light">Our Services</Button>
      </div>
    </div>
  </article>
  <ClientLogos />
  <CaseStudySlider
    eyebrow="/ why not read more"
    heading="Our Related Case Studies"
    action={{ label: 'View All Case Studies', href: OUR_WORK }}
    caseStudies={related(caseStudy, all).map(summariseCaseStudy)}
  />
</Base>
