---
// Our Work: every Case Study, filterable by Service and Industry, then the
// newest work, the Pillars, the newsletter band and the Industries, as on the
// live page. The live page's "Our services" block, six cards linking to old
// service addresses, is left out: the Pillar cards above it cover the same
// ground with current addresses.
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import CaseStudyListing from '../../components/CaseStudyListing.astro';
import CaseStudySlider from '../../components/CaseStudySlider.astro';
import IndustryCard from '../../components/IndustryCard.astro';
import PillarCards from '../../components/PillarCards.astro';
import ClientLogos from '../../components/home/ClientLogos.astro';
import ConnectWithUs from '../../components/home/ConnectWithUs.astro';
import { getCaseStudies, getIndustries, summarise } from '../../content/case-studies';

const caseStudies = (await getCaseStudies()).map(summarise);
const industries = await getIndustries();
---

<Base title="Our Work | Chesamel" description="See our latest customer stories and learn how we turn our solutions into results.">
  <section class="bg-black">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6">
      <h1 class="type-heading-1 text-white">Our Work</h1>
      <p class="mt-4 max-w-2xl font-subheading text-lg text-off-white">
        See our latest customer stories and learn how we turn our solutions into results.
      </p>
    </div>
  </section>
  <nav aria-label="Breadcrumb" class="type-caption border-b border-light-grey">
    <ol class="mx-auto flex max-w-7xl flex-wrap gap-2 px-4 py-4 sm:px-6">
      <li><a href="/" class="underline">Home</a> /</li>
      <li><a href="/insights/" class="underline">Insights</a> /</li>
      <li aria-current="page">Our Work</li>
    </ol>
  </nav>
  <section aria-labelledby="catalogue" class="bg-black">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6">
      <h2 id="catalogue" class="type-heading-2 mb-10 text-white">Our catalogue</h2>
      <CaseStudyListing caseStudies={caseStudies} tone="dark" />
    </div>
  </section>
  <ClientLogos />
  <CaseStudySlider id="latest-work" heading="Latest Work" tone="light" caseStudies={caseStudies.slice(0, 3)} />
  <PillarCards>
    <h2 class="type-heading-2">How we add value</h2>
    <p class="mt-6 max-w-md">
      We're a Business Transformation Consultancy providing end-to-end solutions through human ingenuity and advanced
      technology to drive positive change for a better future.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="/what-we-do/" tone="dark">Find out more</Button>
      <Button href="/insights/" tone="light">Our Insights</Button>
    </div>
  </PillarCards>
  <ConnectWithUs />
  <section aria-labelledby="our-industries" class="bg-black">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6">
      <p class="font-subheading text-off-white">/ experience and expertise in an array of fields</p>
      <h2 id="our-industries" class="type-heading-2 mt-3 text-white">Our Industries</h2>
      <div class="mt-12 grid gap-6 lg:grid-cols-[1fr_3fr]">
        <div class="flex flex-col justify-between gap-6 bg-indigo p-6">
          <div>
            <h3 class="type-heading-3 text-white">Discover more</h3>
            <p class="mt-4 text-white">How we work in each of our industries, and the value we bring.</p>
          </div>
          <div><Button href="/industries/" tone="dark">find out more</Button></div>
        </div>
        <ul class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
          {industries.map((industry) => <li><IndustryCard industry={industry} tone="dark" /></li>)}
        </ul>
      </div>
    </div>
  </section>
</Base>
