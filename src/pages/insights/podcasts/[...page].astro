---
// Podcast: every episode of Chesamel Unplugged, newest first. Unlike the live
// listing, each card links to the episode's own page. 3 episodes a page
// (#42): later pages are /insights/podcasts/page/N/.
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import InsightsHero from '../../../components/InsightsHero.astro';
import ListenLinks from '../../../components/ListenLinks.astro';
import Button from '../../../components/Button.astro';
import CtaBlock from '../../../components/CtaBlock.astro';
import { getNewest, addressOf, excerpt } from '../../../content/insight-items';
import { formatDate, isoDate } from '../../../content/shared';
import CaseStudySlider from '../../../components/CaseStudySlider.astro';
import { getCaseStudies, summariseCaseStudy } from '../../../content/case-studies';
import Pager from '../../../components/Pager.astro';
import ListingRedirect from '../../../components/ListingRedirect.astro';
import { insightsTrail } from '../../../components/trails';
import { listings, pagePaths, pageHref } from '../../../content/paging';
import { pageMeta, pagedMeta } from '../../../lib/seo';

const { base: BASE, perPage: PER_PAGE } = listings.podcasts;

export const getStaticPaths = (async ({ paginate }) => pagePaths(paginate, await getNewest('podcasts'), listings.podcasts.perPage)) satisfies GetStaticPaths;

const { current, last } = Astro.props;
const podcasts = (await getNewest('podcasts')).slice((current - 1) * PER_PAGE, current * PER_PAGE);
// The live page's hand-picked "Customer stories".
const customerStories = ['elevating-fan-experiences-at-the-brits', 'b2b-marketing-for-ebay', 'augmenting-cybersecurity-with-ai'];
const caseStudies = await getCaseStudies();
const stories = customerStories.map((id) => caseStudies.find((c) => c.id === id)!).map(summariseCaseStudy);
const trail = insightsTrail({ label: 'Podcast' });
---

<Base seo={{ ...pagedMeta(pageMeta(BASE), current, last), breadcrumb: trail }}>
  <ListingRedirect base={BASE} last={last} />
  <InsightsHero heading="Podcast" text="Listen to the latest episodes in our podcast series, Chesamel Unplugged." trail={trail} />
  <section class="bg-black">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-6 px-5 py-12 sm:px-6">
      <h2 class="type-heading-2 text-white">Listen to Chesamel Unplugged</h2>
      <Button href="https://open.spotify.com/show/3vQMN7K3w5z6T23vDhipjt" tone="outline">Listen now</Button>
    </div>
  </section>
  <section aria-labelledby="episodes" class="mx-auto max-w-5xl px-5 py-16 sm:px-6 lg:py-20">
    <p class="type-caption">/ explore our</p>
    <h2 id="episodes" class="type-heading-2 mt-2">Latest episodes</h2>
    <ul class="mt-10 grid gap-6">
      {
        podcasts.map((p) => (
          <li class="border border-light-grey p-6" data-component="podcast-card">
            <h3 class="type-heading-3 text-2xl leading-tight">
              <a href={addressOf(p)} class="hover:underline">
                {p.data.title}
              </a>
            </h3>
            <p class="type-caption mt-3 flex flex-wrap gap-x-6 gap-y-1">
              <span>
                with our guest <strong class="font-semibold text-black">{p.data.guest}</strong>
              </span>
              <time datetime={isoDate(p.data.date)}>{formatDate(p.data.date)}</time>
            </p>
            <p class="mt-4">{excerpt(p.body ?? '')}</p>
            <div class="mt-5">
              <ListenLinks listen={p.data.listen} episode={p.data.title} />
            </div>
          </li>
        ))
      }
    </ul>
    <Pager last={last} current={current} href={pageHref(BASE)} label="Podcast pages" />
  </section>
  <CtaBlock
    heading="Feature on our podcast"
    text="Want to share your story, some business advice, or talk about a topic you're an expert in? We're always looking for new guests."
    actions={[{ label: 'Get in Touch', href: '/contact/', tone: 'indigo' }]}
  />
  <CaseStudySlider heading="Customer stories" action={{ label: 'View All', href: '/insights/our-work/' }} caseStudies={stories} />
</Base>
