---
// News: every Blog Post, filterable by Pillar and Industry. The live site
// serves News at /insights/blog/, so that address is kept.
import Base from '../../layouts/Base.astro';
import InsightsHero from '../../components/InsightsHero.astro';
import BlogPostListing from '../../components/BlogPostListing.astro';
import { getBlogPosts, summarisePost } from '../../content/blog';

const posts = (await getBlogPosts()).map(summarisePost);
---

<Base title="News | Chesamel" description="The latest thoughts, updates, and helpful how-tos from Chesamel.">
  <InsightsHero heading="News" text="The latest thoughts, updates, and helpful how-tos." />
  <div class="mx-auto max-w-7xl px-5 py-16 sm:px-6 lg:py-20">
    <BlogPostListing posts={posts} />
  </div>
</Base>
