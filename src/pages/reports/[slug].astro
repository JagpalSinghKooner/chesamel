---
// A Report at its original address: its intro, then the download box. On the
// live site a HubSpot form emails the full report; until forms are built
// (#11), the box asks the reader to get in touch instead.
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import InsightHeader from '../../components/InsightHeader.astro';
import LabelLinks from '../../components/LabelLinks.astro';
import Button from '../../components/Button.astro';
import { insightsTrail } from '../../components/trails';
import { addressOf, getNewest, type Report } from '../../content/insight-items';
import { primaryPillar } from '../../content/shared';
import { entryMeta } from '../../lib/seo';
import { absolute, article } from '../../lib/structured-data';

export async function getStaticPaths() {
  return (await getNewest('reports')).map((report) => ({ params: { slug: report.id }, props: { report } }));
}

const { report } = Astro.props as { report: Report };
const { title, date, image, pillars } = report.data;
const { Content } = await render(report);
const meta = entryMeta(report);
const trail = insightsTrail({ label: 'Reports', href: '/insights/reports/' });
const story = article('Article', { url: absolute(addressOf(report)), headline: title, description: meta.description, date, image });
---

<Base seo={{ ...meta, image, type: 'article', breadcrumb: trail, schema: [story] }}>
  <article class="mx-auto max-w-3xl px-5 py-16 sm:px-6 lg:py-20">
    <InsightHeader trail={trail} pillar={primaryPillar(report.data)} title={title} />
    <div class="blog-body mt-10">
      <Content />
    </div>
    <section aria-labelledby="download" class="mt-12 grid gap-8 border border-light-grey p-6 sm:grid-cols-[1fr_14rem] sm:p-8" data-report-download>
      <div class="flex flex-col">
        <p class="type-caption">/ explore report</p>
        <h2 id="download" class="type-heading-3 mt-2 text-2xl">Download Full Report</h2>
        <p class="mt-4 text-dark-grey">Online download is coming soon. Get in touch and we'll send you the full report.</p>
        <div class="mt-6">
          <Button href="/contact/" tone="indigo">Request the full report</Button>
        </div>
      </div>
      <img src={image.src} alt={image.alt} class="w-full self-start" />
    </section>
    <LabelLinks pillars={pillars} servicesHeading="Related services" />
  </article>
</Base>
